---
import type { GalleryItem } from '@/utils/portfolio';

interface Props {
  items: GalleryItem[];
  class?: string;
}

const { items, class: className = '' } = Astro.props;

// A gallery-wall rhythm: large / small offset, then a wide closing frame.
const layout = [
  { span: 'md:col-span-7', aspect: 'aspect-[4/5]', sizes: '(min-width: 768px) 55vw, 92vw' },
  { span: 'md:col-span-4 md:col-start-9 md:mt-48', aspect: 'aspect-[3/4]', sizes: '(min-width: 768px) 32vw, 92vw' },
  { span: 'md:col-span-5 md:col-start-2', aspect: 'aspect-[4/5]', sizes: '(min-width: 768px) 40vw, 92vw' },
  { span: 'md:col-span-5 md:col-start-8 md:mt-32', aspect: 'aspect-[4/5]', sizes: '(min-width: 768px) 40vw, 92vw' },
  { span: 'md:col-span-10 md:col-start-2', aspect: 'aspect-[16/9]', sizes: '(min-width: 768px) 80vw, 92vw' },
  { span: 'md:col-span-6', aspect: 'aspect-[5/4]', sizes: '(min-width: 768px) 48vw, 92vw' },
];
---

<div class:list={['grid grid-cols-1 gap-x-8 gap-y-20 md:grid-cols-12 md:gap-y-28', className]}>
  {
    items.slice(0, layout.length).map((item, i) => {
      const { span, aspect, sizes } = layout[i];
      return (
        <a href="/portfolio" class:list={['group block', span]}>
          <div class:list={['relative overflow-hidden bg-cream-50', aspect]} data-reveal-clip>
            <img
              src={item.src}
              srcset={item.srcSet}
              sizes={sizes}
              width={item.width}
              height={item.height}
              alt={`${item.title} — ${item.category} event in ${item.location}`}
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover transition-transform duration-[1800ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.04]"
            />
          </div>
          <div class="mt-6 flex items-baseline justify-between gap-6" data-reveal>
            <div class="flex items-baseline gap-5">
              <span class="index-num text-lg text-gold-300">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="font-display text-2xl leading-snug text-cream transition-colors duration-500 group-hover:text-gold-300 md:text-[2rem]">
                {item.title}
              </h3>
            </div>
            <p class="mono-label hidden shrink-0 text-[0.66rem] text-muted-400 sm:block">
              {item.location.split(',').slice(-1)[0].trim()} · {item.year}
            </p>
          </div>
        </a>
      );
    })
  }
</div>
