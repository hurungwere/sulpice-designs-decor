---
import { Icon } from 'astro-icon/components';
import type { GalleryItem } from '@/utils/portfolio';

interface Props {
  items: GalleryItem[];
  class?: string;
}

const { items, class: className = '' } = Astro.props;

const layout = [
  { span: 'md:col-span-7', aspect: 'aspect-[4/5]', offset: '' },
  { span: 'md:col-span-5', aspect: 'aspect-[3/4]', offset: 'md:mt-24' },
  { span: 'md:col-span-5', aspect: 'aspect-[4/5]', offset: '' },
  { span: 'md:col-span-7', aspect: 'aspect-[16/11]', offset: 'md:mt-24' },
  { span: 'md:col-span-6', aspect: 'aspect-[5/4]', offset: '' },
  { span: 'md:col-span-6', aspect: 'aspect-[5/4]', offset: 'md:mt-16' },
];
---

<div class:list={['grid grid-cols-1 gap-x-6 gap-y-12 md:grid-cols-12', className]}>
  {
    items.slice(0, layout.length).map((item, i) => {
      const { span, aspect, offset } = layout[i];
      const idx = String(i + 1).padStart(2, '0');
      return (
        <a
          href="/portfolio"
          class:list={['group block', span, offset]}
          data-reveal-clip
        >
          <div class:list={['relative overflow-hidden rounded-2xl bg-cream-100 ring-1 ring-charcoal/5', aspect]}>
            <img
              src={item.src}
              srcset={item.srcSet}
              sizes="(min-width: 768px) 45vw, 92vw"
              width={item.width}
              height={item.height}
              alt={`${item.title} — ${item.category} project in ${item.location}`}
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover transition-transform duration-[1200ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.04]"
            />
            <span
              class="pointer-events-none absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-charcoal/20 to-transparent opacity-0 transition-opacity duration-700 group-hover:opacity-100"
              aria-hidden="true"
            />
            <span class="bg-gold-gradient absolute right-4 top-4 flex h-10 w-10 translate-y-1 items-center justify-center rounded-full text-ink opacity-0 shadow-[0_10px_24px_-12px_rgba(184,134,11,0.9)] backdrop-blur-sm transition-all duration-500 group-hover:translate-y-0 group-hover:opacity-100">
              <Icon name="lucide:arrow-up-right" class="h-4 w-4" />
            </span>
          </div>
          <div class="mt-5 flex items-start justify-between gap-4">
            <div>
              <p class="mono-label text-gold-600">
                {idx} / {item.category}
              </p>
              <h3 class="mt-2 font-display text-xl leading-snug text-charcoal transition-colors group-hover:text-gold-600 md:text-2xl">
                {item.title}
              </h3>
              <p class="mt-1 font-mono text-[0.68rem] uppercase tracking-[0.14em] text-muted-400">
                {item.location} · {item.year}
              </p>
            </div>
          </div>
        </a>
      );
    })
  }
</div>
