---
interface Props {
  href?: string;
  type?: 'button' | 'submit';
  variant?: 'primary' | 'gold' | 'outline' | 'ghost' | 'light';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  type = 'button',
  variant = 'primary',
  size = 'md',
  class: className = '',
  ...rest
} = Astro.props;

const base =
  'group/btn relative inline-flex items-center justify-center gap-3 overflow-hidden whitespace-nowrap font-sans font-[450] uppercase tracking-[0.28em] transition-[color,background-color,border-color] duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] disabled:cursor-not-allowed disabled:opacity-60';

const variants: Record<string, string> = {
  primary: 'bg-cream text-paper hover:bg-gold hover:text-ink',
  gold: 'bg-gold-gradient text-ink hover:brightness-110',
  outline: 'border border-cream/35 text-cream hover:border-cream hover:bg-cream hover:text-paper',
  light: 'border border-white/50 text-white hover:border-white hover:bg-white hover:text-ink',
  ghost: 'link-hairline !tracking-[0.3em] text-cream hover:text-gold-300',
};

const sizes: Record<string, string> = {
  sm: 'h-10 px-5 text-[0.68rem]',
  md: 'h-12 px-8 text-[0.66rem]',
  lg: 'h-14 px-10 text-[0.68rem]',
};

const cls = `${base} ${variants[variant]} ${variant === 'ghost' ? '' : sizes[size]} ${className}`;
---

{
  href ? (
    <a href={href} class={cls} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class={cls} {...rest}>
      <slot />
    </button>
  )
}
