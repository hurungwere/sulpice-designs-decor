---
import { getImage } from 'astro:assets';
import Logo from '@/components/Logo.astro';
import logoLight from '@/assets/brand/logo-light.png';

// Same file as the visible logo, reused as a mask so the light sweep follows its shape.
const mask = await getImage({ src: logoLight, width: 440, format: 'webp' });
---

<div
  id="preloader"
  class="preloader"
  role="status"
  aria-live="polite"
  aria-label="Loading Sulpice Designs"
>
  <div class="preloader__inner">
    <div class="preloader__logo" style={`--logo-mask:url(${mask.src})`}>
      <Logo width={220} loading="eager" decorative />
      <span class="preloader__sheen" aria-hidden="true"></span>
    </div>
    <span class="preloader__bar" aria-hidden="true"><span></span></span>
  </div>
</div>

<script is:inline>
  (function () {
    var el = document.getElementById('preloader');
    if (!el) return;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!document.documentElement.classList.contains('preloading')) {
      el.remove();
      return;
    }
    var minVisible = reduce ? 0 : 1650;
    var start = performance.now();
    var done = false;

    function hide() {
      if (done) return;
      done = true;
      var wait = Math.max(0, minVisible - (performance.now() - start));
      setTimeout(function () {
        el.classList.add('is-hidden');
        var finish = function () {
          el.remove();
          document.documentElement.classList.remove('preloading');
        };
        el.addEventListener('transitionend', finish, { once: true });
        setTimeout(finish, reduce ? 60 : 900);
      }, wait);
    }

    function ready() {
      hide();
    }

    if (document.readyState === 'complete') ready();
    else window.addEventListener('load', ready, { once: true });

    setTimeout(hide, 3500);
  })();
</script>
