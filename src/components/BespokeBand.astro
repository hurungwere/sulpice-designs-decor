---
import Button from '@/components/Button.astro';

interface Props {
  title?: string;
  lead?: string;
}

const {
  title = 'Something bespoke in mind?',
  lead = 'Custom colour palettes, monogrammed dance floors, branded backdrops — tell us the vision and we will build it around you.',
} = Astro.props;
---

<section class="container-luxe" aria-label="Bespoke requests">
  <div
    class="grid items-center gap-8 border-y border-gold/30 py-14 md:grid-cols-12 md:py-16"
    data-reveal
  >
    <p class="display-md text-balance text-cream md:col-span-5">
      {title}
    </p>
    <p class="max-w-md text-[0.98rem] leading-[1.85] text-muted md:col-span-4">{lead}</p>
    <div class="md:col-span-3 md:justify-self-end">
      <Button href="/contact" variant="gold">Request a custom quote</Button>
    </div>
  </div>
</section>
