---
import { Image, getImage } from 'astro:assets';
import MobileMenu from '@/components/MobileMenu.tsx';
import { SITE } from '@/data/site';
import monogram from '@/assets/brand/monogram.png';

interface Props {
  transparent?: boolean;
}
const { transparent = false } = Astro.props;

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);

const mobileLogo = await getImage({ src: monogram, width: 96, format: 'webp' });
---

<header
  id="site-header"
  data-transparent={transparent ? 'true' : 'false'}
  class:list={[
    'fixed inset-x-0 top-0 z-50 border-b transition-[background-color,border-color,backdrop-filter] duration-700 ease-[cubic-bezier(0.22,1,0.36,1)]',
    transparent
      ? 'border-transparent bg-transparent data-[scrolled=true]:border-cream/10 data-[scrolled=true]:bg-ink/85 data-[scrolled=true]:backdrop-blur-xl'
      : 'border-cream/10 bg-ink/85 backdrop-blur-xl',
  ]}
>
  <div
    class="container-luxe grid grid-cols-[1fr_auto] items-center py-5 transition-[padding] duration-700 lg:grid-cols-[1fr_auto_1fr] lg:py-6"
    id="header-inner"
  >
    <!-- Brand -->
    <a
      href="/"
      class="group flex items-center gap-3.5 justify-self-start"
      aria-label={`${SITE.name} — home`}
    >
      <Image
        src={monogram}
        alt=""
        width={96}
        height={97}
        loading="eager"
        class="h-10 w-auto transition-transform duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.04] md:h-11"
      />
      <span class="flex flex-col leading-none">
        <span class="brand-name font-display text-[1.35rem] font-medium uppercase tracking-[0.2em]">
          Sulpice
        </span>
        <span class="mt-1 text-[0.52rem] font-[450] uppercase tracking-[0.42em] text-gold-300">
          Designs &amp; Decor
        </span>
      </span>
    </a>

    <!-- Desktop nav -->
    <nav aria-label="Primary" class="hidden items-center gap-10 lg:flex">
      {
        SITE.nav.map((item) => {
          const active = isActive(item.href);
          return (
            <a
              href={item.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'nav-link group relative py-1.5 text-[0.66rem] font-[450] uppercase tracking-[0.3em] transition-colors duration-500',
                active ? 'text-gold-300' : 'text-cream/75 hover:text-cream',
              ]}
            >
              {item.label}
              <span
                aria-hidden="true"
                class:list={[
                  'absolute -bottom-0.5 left-0 h-px w-full origin-left bg-gold transition-transform duration-700 ease-[cubic-bezier(0.22,1,0.36,1)]',
                  active ? 'scale-x-100' : 'scale-x-0 group-hover:scale-x-100',
                ]}
              />
            </a>
          );
        })
      }
    </nav>

    <!-- Actions -->
    <div class="flex items-center justify-self-end gap-6">
      <a
        href={`tel:${SITE.phoneHref}`}
        class="nav-link hidden text-[0.66rem] font-[450] uppercase tracking-[0.24em] text-cream/75 transition-colors duration-500 hover:text-cream xl:inline"
      >
        {SITE.phone}
      </a>
      <a
        href="/contact"
        class="hidden h-10 items-center border border-gold/60 px-5 text-[0.62rem] font-[450] uppercase tracking-[0.28em] text-gold-300 transition-colors duration-500 hover:border-gold hover:bg-gold hover:text-ink sm:inline-flex"
      >
        Request a quote
      </a>
      <MobileMenu
        client:load
        nav={[...SITE.nav]}
        phone={SITE.phone}
        phoneHref={SITE.phoneHref}
        logoSrc={mobileLogo.src}
      />
    </div>
  </div>
</header>
