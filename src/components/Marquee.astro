---
interface Props {
  items: string[];
  variant?: 'display' | 'mono';
  outline?: boolean;
  duration?: number;
  class?: string;
}

const {
  items,
  variant = 'display',
  outline = false,
  duration = 40,
  class: className = '',
} = Astro.props;

const row = [...items, ...items];
const textClass =
  variant === 'mono'
    ? 'mono-label text-[0.68rem]'
    : outline
      ? 'font-display italic text-5xl md:text-7xl text-transparent [-webkit-text-stroke:1px_currentColor]'
      : 'font-display italic text-5xl md:text-7xl';
const gap = variant === 'mono' ? 'px-7' : 'px-8 md:px-12';
---

<div class:list={['marquee-mask overflow-hidden', className]} aria-hidden="true">
  <div
    class="flex w-max animate-marquee items-center"
    style={`--marquee-duration:${duration}s`}
  >
    {
      row.map((item) => (
        <span class="flex items-center">
          <span class:list={['whitespace-nowrap leading-none', gap, textClass]}>{item}</span>
          <span class="diamond" />
        </span>
      ))
    }
  </div>
</div>
