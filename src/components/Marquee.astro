---
interface Props {
  items: string[];
  variant?: 'display' | 'mono';
  outline?: boolean;
  duration?: number;
  class?: string;
}

const {
  items,
  variant = 'display',
  outline = false,
  duration = 40,
  class: className = '',
} = Astro.props;

const row = [...items, ...items];
const textClass =
  variant === 'mono'
    ? 'font-mono text-[0.72rem] font-semibold uppercase tracking-[0.24em]'
    : outline
      ? 'font-display text-2xl md:text-3xl text-transparent [-webkit-text-stroke:1px_currentColor]'
      : 'font-display text-2xl md:text-3xl';
---

<div class:list={['marquee-mask overflow-hidden', className]} aria-hidden="true">
  <div
    class="flex w-max animate-marquee items-center"
    style={`--marquee-duration:${duration}s`}
  >
    {
      row.map((item) => (
        <span class="flex items-center">
          <span class:list={['whitespace-nowrap px-6', textClass]}>{item}</span>
          <span class="h-2 w-2 shrink-0 rounded-full bg-gold-gradient shadow-[0_0_12px_rgba(229,197,88,0.45)]" />
        </span>
      ))
    }
  </div>
</div>
