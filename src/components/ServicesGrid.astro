---
import { Image } from 'astro:assets';
import SectionHeading from '@/components/SectionHeading.astro';
import { Icon } from 'astro-icon/components';
import { SERVICES } from '@/data/services';
---

<section class="bg-cream-100 py-24 md:py-32" aria-labelledby="services-heading">
  <div class="container-luxe">
    <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-end">
      <SectionHeading
        id="services-heading"
        eyebrow="What we do"
        title="Design services tailored to your space"
        lead="Four core offerings, one philosophy — thoughtful design that holds its value long after the trend has passed."
      />
      <a
        href="/services"
        class="group hidden items-center gap-2 whitespace-nowrap text-sm font-medium text-charcoal transition-colors hover:text-gold-600 md:inline-flex"
        data-reveal
      >
        All services
        <Icon
          name="lucide:arrow-right"
          class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
        />
      </a>
    </div>

    <div class="mt-14 grid gap-6 sm:grid-cols-2">
      {
        SERVICES.map((service, i) => (
          <a
            href={`/services#${service.slug}`}
            class="group relative flex flex-col overflow-hidden rounded-3xl bg-cream shadow-card transition-all duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-1 hover:shadow-soft"
            data-reveal
            style={`--reveal-delay:${i * 90}ms`}
          >
            <div class="relative aspect-[16/10] overflow-hidden">
              <Image
                src={service.image}
                alt={service.title}
                widths={[480, 720, 960]}
                sizes="(min-width: 640px) 45vw, 90vw"
                loading="lazy"
                class="h-full w-full object-cover transition-transform duration-[900ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-105"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-ink/45 to-transparent" aria-hidden="true" />
              <span class="absolute left-5 top-5 inline-flex h-11 w-11 items-center justify-center rounded-full bg-gold-gradient text-ink shadow-[0_8px_20px_-10px_rgba(0,0,0,0.6)]">
                <Icon name={service.icon} class="h-5 w-5" />
              </span>
            </div>

            <div class="flex flex-1 flex-col p-7">
              <p class="text-[0.7rem] font-semibold uppercase tracking-[0.2em] text-clay">
                {service.tagline}
              </p>
              <h3 class="mt-3 font-display text-2xl text-charcoal">{service.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-muted">{service.description}</p>
              <span class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-gold-600">
                Learn more
                <Icon
                  name="lucide:arrow-right"
                  class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
                />
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
