---
import SectionHeading from '@/components/SectionHeading.astro';
import TestimonialsSlider from '@/components/TestimonialsSlider.tsx';
import { Icon } from 'astro-icon/components';
import { TESTIMONIALS } from '@/data/testimonials';

const items = TESTIMONIALS.map((t) => ({ ...t }));
---

<section class="bg-cream-100 section-pad" aria-labelledby="testimonials-heading">
  <div class="container-luxe">
    <SectionHeading
      id="testimonials-heading"
      index="05"
      eyebrow="Kind words"
      title="Loved by the people we design for."
      lead="Referrals and returning clients are the truest measure of our work."
      class="mb-10"
    />

    <div
      class="mb-10 flex flex-wrap items-center gap-x-8 gap-y-3"
      data-reveal
    >
      <span class="flex items-center gap-1" aria-label="Average rating 4.9 out of 5">
        {Array.from({ length: 5 }).map((_, i) => (
          <Icon name="lucide:star" class="h-4 w-4 fill-gold-600 text-gold-600" />
        ))}
        <span class="ml-2 font-display text-xl text-cream">4.9 / 5</span>
      </span>
      <span class="h-px w-10 bg-gold-gradient" aria-hidden="true" />
      <p class="font-mono text-xs uppercase tracking-[0.16em] text-muted md:text-[0.7rem]">
        Average rating from our couples &amp; corporate clients · passing it on since 2008
      </p>
    </div>

    <div data-reveal>
      <TestimonialsSlider client:visible items={items} />
    </div>
  </div>
</section>
