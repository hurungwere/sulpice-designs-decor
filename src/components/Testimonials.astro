---
import TestimonialsSlider from '@/components/TestimonialsSlider.tsx';
import { TESTIMONIALS } from '@/data/testimonials';

const items = TESTIMONIALS.map((t) => ({ ...t }));
---

<section class="surface-ivory section-pad" aria-labelledby="testimonials-heading">
  <div class="container-luxe">
    <div class="flex flex-col items-center text-center" data-reveal>
      <span class="mono-label flex items-center gap-4 text-gold-300">
        <span class="h-px w-10 bg-gold/70" aria-hidden="true"></span>
        <span id="testimonials-heading">In their words</span>
        <span class="h-px w-10 bg-gold/70" aria-hidden="true"></span>
      </span>
    </div>

    <div class="mt-14" data-reveal>
      <TestimonialsSlider client:visible items={items} />
    </div>
  </div>
</section>
