---
import { Image } from 'astro:assets';
import Button from '@/components/Button.astro';
import hero1 from '@/assets/hero-1.jpg';
import hero2 from '@/assets/hero-2.jpg';
import hero3 from '@/assets/hero-3.jpg';

const slides = [
  { src: hero1, alt: 'Elegant wedding tent and reception styling by Sulpice Designs Decor', label: 'Receptions' },
  { src: hero2, alt: 'Ceiling draping and warm event lighting by Sulpice Designs Decor', label: 'Draping & light' },
  { src: hero3, alt: 'Styled ceremony florals and place settings by Sulpice Designs Decor', label: 'Ceremonies' },
];
---

<section
  class="relative isolate flex min-h-[100svh] flex-col justify-end overflow-hidden bg-teal-900 text-white"
  aria-label="Introduction"
>
  <!-- Crossfading backdrop -->
  <div class="absolute inset-0 -z-10">
    {
      slides.map((slide, i) => (
        <div class:list={['hero-slide absolute inset-0', `hero-slide-${i}`]}>
          <Image
            src={slide.src}
            alt={slide.alt}
            widths={[768, 1280, 1920, 2400]}
            sizes="100vw"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'auto'}
            class="h-full w-full object-cover"
          />
        </div>
      ))
    }
    <div
      class="absolute inset-0 bg-[linear-gradient(180deg,rgba(2,14,16,0.6)_0%,rgba(2,14,16,0.15)_25%,rgba(2,14,16,0.4)_55%,rgba(3,27,31,0.95)_100%)]"
      aria-hidden="true"
    />
    <div
      class="absolute inset-0 bg-[linear-gradient(90deg,rgba(2,14,16,0.55)_0%,rgba(2,14,16,0.1)_55%,rgba(2,14,16,0.45)_100%)]"
      aria-hidden="true"
    />
  </div>

  <div class="container-luxe w-full pb-10 pt-40 md:pb-12">
    <div class="grid items-end gap-10 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-8">
        <p class="hero-anim mono-label flex items-center gap-4 text-white/80" style="--d:100ms">
          <span class="h-px w-10 bg-gold" aria-hidden="true"></span>
          <span>Events décor &amp; hiring<span class="hidden sm:inline"> · Est. 2008</span></span>
        </p>

        <h1 class="display-xl mt-8 text-balance text-white">
          <span class="hero-line"><span style="--d:200ms">Your dream day,</span></span>
          <span class="hero-line"
            ><span style="--d:320ms" class="italic text-gold-300">styled to the</span></span
          >
          <span class="hero-line"
            ><span style="--d:440ms" class="italic text-gold-300">last detail.</span></span
          >
        </h1>
      </div>

      <div class="hero-anim lg:col-span-4 lg:pb-3" style="--d:650ms">
        <p class="max-w-sm text-[0.98rem] leading-[1.8] text-white/90 [text-shadow:0_1px_18px_rgba(0,0,0,0.45)]">
          Tents, tables, linen and florals for weddings, corporate occasions and private
          celebrations — designed, delivered and styled by our own crew across Zimbabwe
          and South Africa.
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-x-8 gap-y-5">
          <Button href="/contact" variant="light" size="lg">Request a quote</Button>
          <a href="/portfolio" class="link-hairline text-white">View our events</a>
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div
      class="hero-anim mt-16 flex items-center justify-between gap-6 border-t border-white/20 pt-6 md:mt-20"
      style="--d:800ms"
    >
      <p class="mono-label hidden items-center gap-4 text-white/65 sm:flex">
        Harare <span class="diamond opacity-70"></span> Bulawayo
        <span class="diamond opacity-70"></span> Johannesburg
      </p>
      <ol class="flex items-center gap-5" aria-hidden="true">
        {
          slides.map((slide, i) => (
            <li class="flex items-center gap-3">
              <span class="font-display text-sm italic text-white/70">0{i + 1}</span>
              <span class="relative h-px w-10 overflow-hidden bg-white/25 md:w-16">
                <span class:list={['hero-progress absolute inset-0 origin-left bg-gold', `hero-progress-${i}`]} />
              </span>
              <span class="mono-label hidden text-[0.6rem] text-white/60 lg:inline">{slide.label}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .hero-slide {
    opacity: 0;
    animation: hero-fade 21s linear infinite;
  }
  .hero-slide-1 {
    animation-delay: 7s;
  }
  .hero-slide-2 {
    animation-delay: 14s;
  }
  .hero-slide :global(img) {
    animation: hero-zoom 21s linear infinite;
  }
  .hero-slide-1 :global(img) {
    animation-delay: 7s;
  }
  .hero-slide-2 :global(img) {
    animation-delay: 14s;
  }

  @keyframes hero-fade {
    0% {
      opacity: 0;
    }
    5% {
      opacity: 1;
    }
    33% {
      opacity: 1;
    }
    39% {
      opacity: 0;
    }
    100% {
      opacity: 0;
    }
  }
  @keyframes hero-zoom {
    0% {
      transform: scale(1.12);
    }
    40% {
      transform: scale(1.02);
    }
    100% {
      transform: scale(1.02);
    }
  }

  /* Slide indicators run in step with the crossfade */
  .hero-progress {
    transform: scaleX(0);
    animation: hero-progress 21s linear infinite;
  }
  .hero-progress-1 {
    animation-delay: 7s;
  }
  .hero-progress-2 {
    animation-delay: 14s;
  }
  @keyframes hero-progress {
    0% {
      transform: scaleX(0);
      opacity: 1;
    }
    33.3% {
      transform: scaleX(1);
      opacity: 1;
    }
    36% {
      transform: scaleX(1);
      opacity: 0;
    }
    100% {
      transform: scaleX(1);
      opacity: 0;
    }
  }

  /* Headline: each line rises out of a mask */
  .hero-line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
  }
  .hero-line > span {
    display: inline-block;
    animation: hero-line 1.4s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: var(--d, 0ms);
  }
  @keyframes hero-line {
    from {
      transform: translateY(105%);
    }
    to {
      transform: none;
    }
  }

  .hero-anim {
    animation: hero-rise 1.4s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: var(--d, 0ms);
  }
  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* Hold the entrance until the preloader has lifted */
  :global(.preloading) .hero-anim,
  :global(.preloading) .hero-line > span {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-slide,
    .hero-slide :global(img),
    .hero-anim,
    .hero-line > span,
    .hero-progress {
      animation: none !important;
    }
    .hero-slide-0 {
      opacity: 1;
    }
    .hero-progress-0 {
      transform: scaleX(1);
    }
  }
</style>
