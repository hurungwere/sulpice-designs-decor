---
import { Image } from 'astro:assets';
import { SITE } from '@/data/site';
import serviceResidential from '@/assets/service-residential.jpg';
import serviceEvents from '@/assets/service-events.jpg';
import serviceCommercial from '@/assets/service-commercial.jpg';
import project7 from '@/assets/project-7.jpg';
import project1 from '@/assets/project-1.jpg';
import project9 from '@/assets/project-9.jpg';
import hero2 from '@/assets/hero-2.jpg';

const imgs = [
  { src: serviceResidential, alt: 'Elegant event décor by Sulpice Designs Decor', span: 'col-span-2 row-span-2 md:col-span-2 md:row-span-2', link: true },
  { src: project7, alt: 'Styled wedding table by Sulpice Designs Decor', span: 'md:col-span-1 md:row-span-2', link: true },
  { src: project1, alt: 'Ballroom styling by Sulpice Designs Decor', span: 'md:col-span-1 md:row-span-1', link: true },
  { src: serviceEvents, alt: 'Corporate event setup by Sulpice Designs Decor', span: 'md:col-span-1 md:row-span-1', link: true },
  { src: project9, alt: 'Fresh florals and place settings by Sulpice Designs Decor', span: 'md:col-span-1 md:row-span-2', link: true },
  { src: hero2, alt: 'Canopy and lighting hire by Sulpice Designs Decor', span: 'md:col-span-2 md:row-span-2', link: true },
  { src: serviceCommercial, alt: 'Reception styling by Sulpice Designs Decor', span: 'md:col-span-1 md:row-span-2', link: true },
];

const instagram = SITE.socials.find((s) => s.name === 'Instagram')?.href ?? '#';
---

<section class="section-pad" aria-labelledby="gallery-heading">
  <div class="container-luxe">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-8" data-reveal>
        <span class="mono-label flex items-center gap-4 text-gold-300">
          <span class="h-px w-10 bg-gold/70" aria-hidden="true"></span>
          @sulpicedesigns
        </span>
        <h2 id="gallery-heading" class="display-lg mt-8 text-balance text-cream">
          Fresh from the <em class="text-gold-300">event floor.</em>
        </h2>
      </div>
      <div class="lg:col-span-3 lg:col-start-10 lg:justify-self-end" data-reveal>
        <a
          href={instagram}
          target="_blank"
          rel="noopener noreferrer"
          class="link-hairline text-cream hover:text-gold-300"
        >
          Follow on Instagram
        </a>
      </div>
    </div>

    <!-- Mosaic -->
    <div
      class="mt-20 grid grid-flow-dense auto-rows-[8rem] grid-cols-2 gap-2 sm:auto-rows-[10rem] md:grid-cols-4 md:gap-3 md:auto-rows-[11rem] lg:auto-rows-[12.5rem]"
    >
      {
        imgs.map((img, i) => (
          <a
            href={img.link ? instagram : '/portfolio'}
            target={img.link ? '_blank' : undefined}
            rel={img.link ? 'noopener noreferrer' : undefined}
            class:list={['group relative overflow-hidden bg-cream-50', img.span]}
            data-reveal
            style={`--reveal-delay:${i * 60}ms`}
            aria-label={`${img.alt} — view on Instagram`}
          >
            <Image
              src={img.src}
              alt={img.alt}
              widths={[400, 640, 900, 1200]}
              sizes="(min-width: 1024px) 25vw, (min-width: 640px) 45vw, 90vw"
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover transition-transform duration-[1600ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.05]"
            />
            <span
              class="pointer-events-none absolute inset-0 bg-teal-900/0 transition-colors duration-700 group-hover:bg-teal-900/25"
              aria-hidden="true"
            />
          </a>
        ))
      }
    </div>

    <ul
      class="mt-14 flex flex-wrap items-center justify-center gap-x-6 gap-y-4"
      aria-label="Sulpice Designs Decor on social media"
    >
      {
        SITE.socials.map((social, i) => (
          <li class="flex items-center gap-6">
            {i > 0 && <span class="diamond opacity-60" aria-hidden="true" />}
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              class="mono-label text-cream/70 transition-colors duration-500 hover:text-gold-300"
            >
              {social.name}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
