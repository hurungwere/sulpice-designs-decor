---
import { Image } from 'astro:assets';
import { SITE } from '@/data/site';
import monogram from '@/assets/brand/monogram.png';
import Logo from '@/components/Logo.astro';

const year = new Date().getFullYear();
const newsletterKey = import.meta.env.PUBLIC_WEB3FORMS_KEY as string | undefined;

const serviceLinks = [
  { label: 'Tents & Pergolas', href: '/services#tents-pergolas' },
  { label: 'Tables, Chairs & Glassware', href: '/services#tables-chairs' },
  { label: 'Crockery & Linen', href: '/services#crockery-linen' },
  { label: 'Florals & Accessories', href: '/services#florals-accessories' },
];

const heading = 'mono-label text-[0.68rem] text-gold-300';
const link = 'text-[0.95rem] text-cream/70 transition-colors duration-500 hover:text-cream';
---

<footer class="relative overflow-hidden border-t border-cream/10 bg-teal-900 text-cream">
  <div class="container-luxe relative pb-10 pt-24 md:pt-32">
    <!-- Statement + newsletter -->
    <div class="grid gap-14 border-b border-cream/10 pb-20 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <a href="/" class="mb-12 inline-block" aria-label={`${SITE.name} — home`}>
          <Logo width={150} decorative />
        </a>
        <p class="display-md max-w-2xl text-balance">
          Your occasion, <em class="text-gold-300">our craft.</em>
        </p>
        <a href="/contact" class="link-hairline mt-10 text-cream hover:text-gold-300">Request a quote</a>
      </div>

      {
        newsletterKey ? (
          <form
            data-newsletter
            data-key={newsletterKey}
            class="lg:col-span-4 lg:col-start-9"
            aria-label="Newsletter signup"
            novalidate
          >
            <label for="newsletter-email" class={heading}>The Sulpice letter</label>
            <p class="mt-3 text-sm leading-relaxed text-cream/60">
              New collections and seasonal inspiration, a few times a year.
            </p>
            <div class="mt-6 flex items-center border-b border-cream/30 transition-colors duration-500 focus-within:border-gold">
              <input
                id="newsletter-email"
                type="email"
                name="email"
                required
                autocomplete="email"
                placeholder="Your email address"
                class="w-full bg-transparent py-3 text-[0.95rem] text-cream placeholder:text-cream/40 focus:outline-none"
              />
              <button
                type="submit"
                class="shrink-0 py-3 pl-4 text-[0.68rem] uppercase tracking-[0.3em] text-gold-300 transition-colors hover:text-cream"
              >
                Subscribe
              </button>
            </div>
            <p data-newsletter-status class="mt-3 min-h-5 text-sm text-cream/70" aria-live="polite"></p>
          </form>
        ) : (
          <div class="lg:col-span-4 lg:col-start-9">
            <p class={heading}>Stay in touch</p>
            <p class="mt-3 text-sm leading-relaxed text-cream/60">
              New collections, recent events and SEWA intakes — first on Instagram and WhatsApp.
            </p>
            <div class="mt-6 flex flex-wrap gap-x-8 gap-y-4">
              {SITE.socials
                .filter((s) => s.name === 'Instagram' || s.name === 'WhatsApp')
                .map((s) => (
                  <a
                    href={s.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-hairline text-cream hover:text-gold-300"
                  >
                    {s.name}
                  </a>
                ))}
            </div>
          </div>
        )
      }
    </div>

    <!-- Columns -->
    <div class="grid gap-12 py-20 sm:grid-cols-2 lg:grid-cols-12">
      <nav class="lg:col-span-2" aria-label="Footer">
        <h3 class={heading}>Explore</h3>
        <ul class="mt-6 space-y-3">
          {
            SITE.nav.map((item) => (
              <li>
                <a href={item.href} class={link}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav class="lg:col-span-3" aria-label="Collection">
        <h3 class={heading}>The collection</h3>
        <ul class="mt-6 space-y-3">
          {
            serviceLinks.map((item) => (
              <li>
                <a href={item.href} class={link}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="lg:col-span-4">
        <h3 class={heading}>Showrooms</h3>
        <ul class="mt-6 space-y-5">
          {
            SITE.branchContacts.map((branch, i) => (
              <li>
                <p class="font-display text-xl text-cream">{branch.region}</p>
                <p class="mt-1 text-sm text-cream/60">
                  {SITE.showrooms[i]}
                  <span class="mx-2 hidden text-cream/25 sm:inline">·</span>
                  <a href={`tel:${branch.phoneHref}`} class="block whitespace-nowrap transition-colors hover:text-cream sm:inline">
                    {branch.phone}
                  </a>
                </p>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="lg:col-span-3">
        <h3 class={heading}>Enquiries</h3>
        <ul class="mt-6 space-y-3">
          <li>
            <a href={`mailto:${SITE.email}`} class={link}>{SITE.email}</a>
          </li>
          <li>
            <a href={`tel:${SITE.phoneHref}`} class={link}>{SITE.phone}</a>
          </li>
        </ul>
        <dl class="mt-8 space-y-2 text-sm text-cream/60">
          {
            SITE.hours.map((h) => (
              <div class="flex justify-between gap-6 border-b border-cream/10 pb-2">
                <dt>{h.day}</dt>
                <dd class="text-cream/80">{h.time}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>

    <!-- Base -->
    <div
      class="flex flex-col items-center gap-8 border-t border-cream/10 pt-10 md:flex-row md:justify-between"
    >
      <a href="/" class="flex items-center gap-3" aria-label={`${SITE.name} — home`}>
        <Image src={monogram} alt="" width={80} height={81} loading="lazy" class="h-9 w-auto" />
        <span class="font-display text-lg font-medium uppercase tracking-[0.2em]">Sulpice</span>
      </a>

      <ul class="flex flex-wrap items-center justify-center gap-x-7 gap-y-3">
        {
          SITE.socials.map((social) => (
            <li>
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-[0.68rem] uppercase tracking-[0.3em] text-silver transition-colors duration-500 hover:text-gold-300"
              >
                {social.name}
              </a>
            </li>
          ))
        }
      </ul>

      <p class="text-[0.68rem] uppercase tracking-[0.24em] text-cream/40">
        &copy; {year} {SITE.legalName}
      </p>
    </div>
  </div>
</footer>

<script is:inline>
  (function () {
    if (window.__sulpiceNewsletter) return;
    window.__sulpiceNewsletter = true;
    document.addEventListener('submit', function (e) {
      var form = e.target;
      if (!form.matches || !form.matches('form[data-newsletter]')) return;
      e.preventDefault();
      var status = form.querySelector('[data-newsletter-status]');
      var input = form.querySelector('input[type="email"]');
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(input.value.trim())) {
        status.textContent = 'Please enter a valid email address.';
        input.focus();
        return;
      }
      status.textContent = 'Subscribing…';
      var data = new FormData(form);
      data.append('access_key', form.dataset.key);
      data.append('subject', 'Newsletter signup');
      fetch('https://api.web3forms.com/submit', { method: 'POST', body: data, headers: { Accept: 'application/json' } })
        .then(function (r) { return r.json(); })
        .then(function (j) {
          if (!j.success) throw new Error();
          status.textContent = 'Thank you — you are on the list.';
          form.reset();
        })
        .catch(function () {
          status.textContent = 'Could not subscribe just now — please try again later.';
        });
    });
  })();
</script>
