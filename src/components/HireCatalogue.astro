---
import { Image } from 'astro:assets';
import Button from '@/components/Button.astro';
import p1 from '@/assets/service-residential.jpg';
import p2 from '@/assets/service-events.jpg';
import p3 from '@/assets/service-consultation.jpg';
import p4 from '@/assets/service-commercial.jpg';
import p5 from '@/assets/hero-1.jpg';
import p6 from '@/assets/hero-2.jpg';

const products = [
  {
    name: 'Tents & Pergolas',
    specs: ['Wedding marquees', 'Pergolas & covers', 'Garden to rooftop'],
    image: p4,
    href: '/services#tents-pergolas',
  },
  {
    name: 'Tables & Chairs',
    specs: ['Trendy table ranges', 'Plush & classic seating', 'Any guest count'],
    image: p1,
    href: '/services#tables-chairs',
  },
  {
    name: 'Crockery & Linen',
    specs: ['Luxurious linen', 'Full crockery sets', 'Matching themes'],
    image: p2,
    href: '/services#crockery-linen',
  },
  {
    name: 'Florals & Accessories',
    specs: ['Fresh floral styling', 'Ceremony arches', 'Fancy accessories'],
    image: p3,
    href: '/services#florals-accessories',
  },
  {
    name: 'Glassware & Bar',
    specs: ['Bar & serving sets', 'Toasting flutes', 'Complete place settings'],
    image: p5,
    href: '/services',
  },
  {
    name: 'Lighting & Draping',
    specs: ['Ambient event lighting', 'Draping & backdrops', 'Stage & aerial ready'],
    image: p6,
    href: '/services',
  },
];

const standards = [
  { title: 'Our own trucks', body: 'Delivery handled in-house — punctual, and careful with every piece.' },
  { title: 'Our own crew', body: 'Experienced stylists set, dress and clear away, start to finish.' },
  { title: 'One quotation', body: 'The full range under one roof, with a single point of contact.' },
  { title: 'Since 2008', body: 'Trusted for weddings and occasions across Zimbabwe and South Africa.' },
];
---

<section class="section-pad" aria-labelledby="hire-heading">
  <div class="container-luxe">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7" data-reveal>
        <span class="mono-label flex items-center gap-4 text-gold-300">
          <span class="h-px w-10 bg-gold/70" aria-hidden="true"></span>
          The collection
        </span>
        <h2 id="hire-heading" class="display-lg mt-8 text-balance text-cream">
          One house. <em class="text-gold-300">Everything your event needs.</em>
        </h2>
      </div>
      <p
        class="max-w-sm text-[0.98rem] leading-[1.85] text-muted lg:col-span-4 lg:col-start-9"
        data-reveal
        style="--reveal-delay:120ms"
      >
        A complete hire range for weddings, corporate occasions and private celebrations —
        quoted together, delivered by our own trucks, styled by our own hands.
      </p>
    </div>

    <div class="mt-20 grid gap-x-8 gap-y-16 pb-0 sm:grid-cols-2 lg:mt-28 lg:grid-cols-3 lg:gap-x-10 lg:pb-24">
      {
        products.map((product, i) => (
          <a
            href={product.href}
            class:list={['group block', i % 3 === 1 && 'lg:translate-y-24']}
            data-reveal
            style={`--reveal-delay:${(i % 3) * 110}ms`}
          >
            <div class="relative overflow-hidden bg-cream-50">
              <Image
                src={product.image}
                alt={`${product.name} hire by Sulpice Designs Decor`}
                widths={[480, 720, 960]}
                sizes="(min-width: 1024px) 30vw, (min-width: 640px) 46vw, 92vw"
                loading="lazy"
                class="aspect-[4/5] w-full object-cover transition-transform duration-[1600ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.05]"
              />
              <span
                class="pointer-events-none absolute inset-0 bg-teal-900/0 transition-colors duration-700 group-hover:bg-teal-900/15"
                aria-hidden="true"
              />
            </div>
            <div class="mt-7 flex items-baseline gap-5">
              <span class="index-num text-lg text-gold-300">{String(i + 1).padStart(2, '0')}</span>
              <div class="flex-1 border-b border-cream/15 pb-5">
                <h3 class="font-display text-[1.9rem] leading-tight text-cream transition-colors duration-500 group-hover:text-gold-300">
                  {product.name}
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-muted">{product.specs.join(' · ')}</p>
              </div>
            </div>
          </a>
        ))
      }
    </div>

    <!-- The Sulpice standard -->
    <div class="mt-32 grid gap-12 border-t border-cream/15 pt-14 sm:grid-cols-2 lg:mt-40 lg:grid-cols-4 lg:gap-10">
      {
        standards.map((g, i) => (
          <div data-reveal style={`--reveal-delay:${i * 90}ms`}>
            <span class="diamond" aria-hidden="true" />
            <h3 class="mt-6 font-display text-2xl text-cream">{g.title}</h3>
            <p class="mt-3 max-w-xs text-sm leading-[1.8] text-muted">{g.body}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-20 flex justify-center">
      <Button href="/services" variant="outline" size="lg">Explore the full collection</Button>
    </div>
  </div>
</section>
