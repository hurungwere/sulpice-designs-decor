---
import { Image } from 'astro:assets';
import Button from '@/components/Button.astro';
import furniture from '@/assets/hero-1.jpg';
import tent from '@/assets/project-10.jpg';
import bridalStage from '@/assets/service-commercial.jpg';
import tablescape from '@/assets/project-11.jpg';
import ceremony from '@/assets/project-3.jpg';
import lighting from '@/assets/project-7.jpg';

// Disciplines and inventory as listed in the client's corporate profile.
const products = [
  {
    name: 'Equipment & Furniture',
    specs: ['Louis, Ghost & Phoenix chairs', 'Gloss & mirror tables', 'Cocktail bars'],
    image: furniture,
    alt: 'Gold Phoenix chairs at mirror tables with blush place settings',
    href: '/services#tables-chairs',
  },
  {
    name: 'Tents & Structures',
    specs: ['Transparent & clear-span tents', 'Stretch tents', 'Gazebos & cabanas'],
    image: tent,
    alt: 'A large white marquee tent set up on a lawn by Sulpice Designs',
    href: '/services#tents-pergolas',
  },
  {
    name: 'Florals & Bridal Stages',
    specs: ['Opulent bridal stages', 'Bespoke floral arrangements', 'Custom palettes'],
    image: bridalStage,
    alt: 'A white bridal stage sofa framed by lush ivory florals',
    href: '/services#florals-accessories',
  },
  {
    name: 'Reception & Tablescapes',
    specs: ['Charger plates & crystal glass', 'Fine linen & napery', 'Luxury centrepieces'],
    image: tablescape,
    alt: 'A reception table with crystal glassware, a white vase centrepiece and blush napkins',
    href: '/services#crockery-linen',
  },
  {
    name: 'Ceremonies & Aisles',
    specs: ['Altar arches', 'Mirror walkways', 'Flower-lined aisles'],
    image: ceremony,
    alt: 'A ceremony arch of gold columns and hanging crystal strands in a garden',
    href: '/services#florals-accessories',
  },
  {
    name: 'Lighting & Installations',
    specs: ['Chandeliers', 'Fairy-light & floral ceilings', 'Wall & ceiling draping'],
    image: lighting,
    alt: 'A candlelit table with emerald napkins, gold chargers and glowing glassware',
    href: '/services',
  },
];

// "Why choose Sulpice Designs", from the corporate profile.
const standards = [
  { title: '18+ years of excellence', body: 'Proven in luxury décor, spatial design and event training across Southern Africa.' },
  { title: 'A Johannesburg design studio', body: 'Concepts created at our Fourways creative hub, bringing international ideas home.' },
  { title: 'In-house technical expertise', body: 'Engineering-led set-up for safe, high-end tent, power and lighting installations.' },
  { title: 'Complete turnkey service', body: 'From décor hire and printing to full coordination — and even professional training.' },
  { title: 'High-spec inventory', body: 'Transparent tents, Ghost chairs, gloss tables — current, owned and maintained by us.' },
  { title: 'Our own fleet', body: 'Dedicated commercial trucks for seamless delivery across the region.' },
];
---

<section class="section-pad" aria-labelledby="hire-heading">
  <div class="container-luxe">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7" data-reveal>
        <span class="mono-label flex items-center gap-4 text-gold-300">
          <span class="h-px w-10 bg-gold/70" aria-hidden="true"></span>
          The collection
        </span>
        <h2 id="hire-heading" class="display-lg mt-8 text-balance text-cream">
          One house. <em class="text-gold-300">Everything your event needs.</em>
        </h2>
      </div>
      <p
        class="max-w-sm text-[0.98rem] leading-[1.85] text-muted lg:col-span-4 lg:col-start-9"
        data-reveal
        style="--reveal-delay:120ms"
      >
        Seven disciplines and a high-specification inventory, quoted together, delivered by
        our own trucks and styled by our own hands — from intimate weddings to state occasions.
      </p>
    </div>

    <div class="mt-20 grid gap-x-8 gap-y-16 pb-0 sm:grid-cols-2 lg:mt-28 lg:grid-cols-3 lg:gap-x-10 lg:pb-24">
      {
        products.map((product, i) => (
          <a
            href={product.href}
            class:list={['group block', i % 3 === 1 && 'lg:translate-y-24']}
            data-reveal
            style={`--reveal-delay:${(i % 3) * 110}ms`}
          >
            <div class="relative overflow-hidden bg-cream-50">
              <Image
                src={product.image}
                alt={product.alt}
                widths={[480, 720, 960]}
                sizes="(min-width: 1024px) 30vw, (min-width: 640px) 46vw, 92vw"
                loading="lazy"
                class="aspect-[4/5] w-full object-cover transition-transform duration-[1600ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.05]"
              />
              <span
                class="pointer-events-none absolute inset-0 bg-teal-900/0 transition-colors duration-700 group-hover:bg-teal-900/15"
                aria-hidden="true"
              />
            </div>
            <div class="mt-7 flex items-baseline gap-5">
              <span class="index-num text-lg text-gold-300">{String(i + 1).padStart(2, '0')}</span>
              <div class="flex-1 border-b border-cream/15 pb-5">
                <h3 class="font-display text-[1.9rem] leading-tight text-cream transition-colors duration-500 group-hover:text-gold-300">
                  {product.name}
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-muted">{product.specs.join(' · ')}</p>
              </div>
            </div>
          </a>
        ))
      }
    </div>

    <!-- Why choose Sulpice (from the corporate profile) -->
    <div class="mt-32 border-t border-cream/15 pt-14 lg:mt-40">
      <p class="mono-label flex items-center gap-4 text-gold-300">
        <span class="h-px w-10 bg-gold/70" aria-hidden="true"></span>
        Why choose Sulpice
      </p>
    </div>
    <div class="mt-12 grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
      {
        standards.map((g, i) => (
          <div data-reveal style={`--reveal-delay:${i * 90}ms`}>
            <span class="diamond" aria-hidden="true" />
            <h3 class="mt-6 font-display text-2xl text-cream">{g.title}</h3>
            <p class="mt-3 max-w-xs text-sm leading-[1.8] text-muted">{g.body}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-20 flex justify-center">
      <Button href="/services" variant="outline" size="lg">Explore the full collection</Button>
    </div>
  </div>
</section>
