---
import { Image } from 'astro:assets';

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  image: ImageMetadata;
  alt: string;
  crumb?: string;
}

const { eyebrow, title, lead, image, alt, crumb } = Astro.props;
---

<section
  class="relative isolate flex min-h-[78svh] flex-col justify-end overflow-hidden bg-teal-900 text-white"
  aria-labelledby="page-title"
>
  <div class="absolute inset-0 -z-10">
    <Image
      src={image}
      alt={alt}
      widths={[768, 1280, 1920, 2400]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="page-hero-img h-full w-full object-cover"
    />
    <div
      class="absolute inset-0 bg-[linear-gradient(180deg,rgba(4,30,36,0.6)_0%,rgba(4,30,36,0.3)_35%,rgba(6,44,51,0.92)_100%)]"
      aria-hidden="true"
    ></div>
  </div>

  <div class="container-luxe w-full pb-16 pt-44 md:pb-24">
    <nav aria-label="Breadcrumb" class="page-hero-anim mb-10">
      <ol class="mono-label flex items-center gap-4 text-[0.66rem] text-white/60">
        <li><a href="/" class="transition-colors hover:text-white">Home</a></li>
        <li aria-hidden="true"><span class="block h-px w-6 bg-white/40"></span></li>
        <li class="text-gold-300" aria-current="page">{crumb ?? title}</li>
      </ol>
    </nav>

    <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
      <h1 id="page-title" class="page-hero-anim display-lg text-balance lg:col-span-8" style="--d:120ms">
        {title}
      </h1>
      {
        lead && (
          <p
            class="page-hero-anim max-w-md text-[0.98rem] leading-[1.85] text-white/80 lg:col-span-4"
            style="--d:260ms"
          >
            {lead}
          </p>
        )
      }
    </div>
    {
      eyebrow && (
        <p class="page-hero-anim mono-label mt-14 flex items-center gap-4 border-t border-white/20 pt-6 text-[0.66rem] text-white/60" style="--d:380ms">
          <span class="diamond" aria-hidden="true" />
          {eyebrow}
        </p>
      )
    }
  </div>
</section>

<style>
  .page-hero-img {
    animation: page-hero-zoom 2.6s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  @keyframes page-hero-zoom {
    from {
      transform: scale(1.08);
    }
    to {
      transform: scale(1);
    }
  }
  .page-hero-anim {
    animation: page-hero-rise 1.3s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: var(--d, 0ms);
  }
  @keyframes page-hero-rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  :global(.preloading) .page-hero-anim,
  :global(.preloading) .page-hero-img {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .page-hero-img,
    .page-hero-anim {
      animation: none;
    }
  }
</style>
