---
// Event-motif cursor trail: fine gold line-art (flutes, rings, petals, blooms…)
// drifts off the pointer and fades; a click releases a small celebratory burst.
// Desktop: trail + follower ring. Touch: burst on tap only. Off for reduced motion.
---

<canvas
  id="cursor-fx"
  class="pointer-events-none fixed inset-0 z-[65]"
  aria-hidden="true"
  transition:persist
></canvas>

<script is:inline>
  (function () {
    if (window.__sulpiceCursorBound) return;
    window.__sulpiceCursorBound = true;

    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    var fine = window.matchMedia('(pointer: fine)');

    // 24×24 line-art motifs. `fill` motifs are solid, the rest are stroked.
    // `float` < 0 drifts up (balloons, sparkles), > 0 falls (petals, confetti).
    var MOTIFS = [
      { name: 'flute', float: -0.15, d: 'M9 2h6l-.7 7.2a2.3 2.3 0 0 1-4.6 0L9 2z M12 11.6V20 M8.6 21h6.8 M9.4 5.4h5.2' },
      { name: 'ring', float: -0.1, d: 'M6.5 15a5.5 5.5 0 1 0 11 0a5.5 5.5 0 1 0 -11 0z M9.6 6L12 3.4 14.4 6 12 8.6z' },
      { name: 'heart', float: -0.35, d: 'M12 20s-7-4.3-7-9.8A3.9 3.9 0 0 1 12 8a3.9 3.9 0 0 1 7 2.2C19 15.7 12 20 12 20z' },
      { name: 'sparkle', float: -0.3, fill: true, d: 'M12 3c.6 4.6 2.4 6.4 7 7-4.6.6-6.4 2.4-7 7-.6-4.6-2.4-6.4-7-7 4.6-.6 6.4-2.4 7-7z' },
      { name: 'petal', float: 0.45, fill: true, alpha: 0.75, d: 'M12 4c4.2 3.2 5 8.4 0 16-5-7.6-4.2-12.8 0-16z' },
      { name: 'bloom', float: 0.3, bloom: true },
      { name: 'bow', float: -0.05, d: 'M12 11.5C10 8.4 5.8 6.6 4.8 8.6s3.3 5.2 7.2 2.9z M12 11.5c2-3.1 6.2-4.9 7.2-2.9s-3.3 5.2-7.2 2.9z M12 11.5l-2.8 7.5 M12 11.5l2.8 7.5' },
      { name: 'candle', float: -0.1, d: 'M10 11h4v10h-4z M12 11V9 M12 3.2c1.6 2 1.6 3.6 0 5-1.6-1.4-1.6-3 0-5z' },
      { name: 'balloon', float: -0.55, d: 'M7 9.2a5 6 0 1 0 10 0a5 6 0 1 0 -10 0z M11.2 16.4h1.6L12 15.2z M12 16.4c-1.2 1.6.9 2.6-.2 5' },
      { name: 'confetti', float: 0.6, confetti: true },
    ];
    var GOLDS = ['#e1ba39', '#f0d27a', '#fff1a8', '#e1ba39', '#c9ced3'];
    var paths = {};
    MOTIFS.forEach(function (m) {
      if (m.d) paths[m.name] = new Path2D(m.d);
    });

    var canvas, ctx, dpr, w, h, raf = 0;
    var items = [];
    var mouse = { x: -100, y: -100, inside: false };
    var ring = { x: -100, y: -100, r: 16, target: 16 };
    var last = { x: 0, y: 0, set: false };
    var trail = false;
    var MAX = 46;

    function setup() {
      canvas = document.getElementById('cursor-fx');
      if (!canvas) return false;
      ctx = canvas.getContext('2d');
      resize();
      return true;
    }

    function resize() {
      if (!canvas) return;
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = window.innerWidth;
      h = window.innerHeight;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      canvas.style.width = w + 'px';
      canvas.style.height = h + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function rand(a, b) {
      return a + Math.random() * (b - a);
    }

    function spawn(x, y, burst, dx, dy) {
      var m = MOTIFS[(Math.random() * MOTIFS.length) | 0];
      var angle = burst ? rand(0, Math.PI * 2) : Math.atan2(-dy || 0, -dx || 1) + rand(-0.9, 0.9);
      var speed = burst ? rand(1.4, 3.4) : rand(0.25, 0.9);
      items.push({
        m: m,
        x: x,
        y: y,
        vx: Math.cos(angle) * speed,
        vy: Math.sin(angle) * speed + (burst ? -1.2 : 0),
        rot: rand(-0.6, 0.6),
        vr: rand(-0.02, 0.02) * (m.float > 0 ? 2.5 : 1),
        size: burst ? rand(26, 38) : rand(24, 34),
        life: 0,
        ttl: burst ? rand(70, 110) : rand(80, 125),
        sway: rand(0, Math.PI * 2),
        color: GOLDS[(Math.random() * GOLDS.length) | 0],
      });
      if (items.length > MAX) items.splice(0, items.length - MAX);
    }

    function drawItem(it, k) {
      var m = it.m;
      var s = it.size / 24;
      ctx.save();
      ctx.translate(it.x, it.y);
      ctx.rotate(it.rot);
      ctx.scale(s * k, s * k);
      ctx.translate(-12, -12);
      ctx.strokeStyle = it.color;
      ctx.fillStyle = it.color;
      ctx.lineWidth = 1.5 / (s * k);
      ctx.lineJoin = 'round';
      ctx.lineCap = 'round';

      if (m.bloom) {
        // five-petal blossom with a fine centre
        for (var p = 0; p < 5; p++) {
          ctx.save();
          ctx.translate(12, 12);
          ctx.rotate((p * Math.PI * 2) / 5);
          ctx.beginPath();
          ctx.ellipse(0, -4.6, 2.6, 4.2, 0, 0, Math.PI * 2);
          ctx.stroke();
          ctx.restore();
        }
        ctx.beginPath();
        ctx.arc(12, 12, 1.4, 0, Math.PI * 2);
        ctx.fill();
      } else if (m.confetti) {
        // a slim ribbon of confetti that flutters as it turns
        ctx.translate(12, 12);
        ctx.scale(1, Math.cos(it.sway * 3));
        ctx.fillRect(-1.4, -5, 2.8, 10);
      } else if (m.fill) {
        if (m.alpha) ctx.globalAlpha *= m.alpha;
        ctx.fill(paths[m.name]);
      } else {
        ctx.stroke(paths[m.name]);
      }
      ctx.restore();
    }

    function frame() {
      ctx.clearRect(0, 0, w, h);

      for (var i = items.length - 1; i >= 0; i--) {
        var it = items[i];
        it.life++;
        if (it.life >= it.ttl) {
          items.splice(i, 1);
          continue;
        }
        it.sway += 0.05;
        it.vx *= 0.97;
        it.vy = it.vy * 0.97 + it.m.float * 0.045;
        it.x += it.vx + Math.sin(it.sway) * (it.m.float > 0 ? 0.45 : 0.2);
        it.y += it.vy;
        it.rot += it.vr;

        var t = it.life / it.ttl;
        var grow = t < 0.18 ? 0.45 + (t / 0.18) * 0.55 : 1;
        ctx.globalAlpha = t < 0.12 ? t / 0.12 : t > 0.55 ? 1 - (t - 0.55) / 0.45 : 1;
        drawItem(it, grow);
      }
      ctx.globalAlpha = 1;

      if (trail && mouse.inside) {
        ring.x += (mouse.x - ring.x) * 0.16;
        ring.y += (mouse.y - ring.y) * 0.16;
        ring.r += (ring.target - ring.r) * 0.14;
        ctx.beginPath();
        ctx.arc(ring.x, ring.y, ring.r, 0, Math.PI * 2);
        ctx.strokeStyle = 'rgba(225, 186, 57, 0.6)';
        ctx.lineWidth = 1;
        ctx.stroke();
      }

      var settled =
        Math.abs(mouse.x - ring.x) < 0.3 &&
        Math.abs(mouse.y - ring.y) < 0.3 &&
        Math.abs(ring.target - ring.r) < 0.3;
      if (items.length || (trail && mouse.inside && !settled)) {
        raf = requestAnimationFrame(frame);
      } else {
        raf = 0;
      }
    }

    function wake() {
      if (!raf && ctx) raf = requestAnimationFrame(frame);
    }

    function onMove(e) {
      if (e.pointerType !== 'mouse') return;
      if (!mouse.inside) {
        ring.x = e.clientX;
        ring.y = e.clientY;
      }
      mouse.x = e.clientX;
      mouse.y = e.clientY;
      mouse.inside = true;
      if (!last.set) {
        last.x = mouse.x;
        last.y = mouse.y;
        last.set = true;
      }
      var dx = mouse.x - last.x;
      var dy = mouse.y - last.y;
      if (dx * dx + dy * dy > 90 * 90) {
        spawn(mouse.x, mouse.y, false, dx, dy);
        last.x = mouse.x;
        last.y = mouse.y;
      }
      wake();
    }

    function onDown(e) {
      // keep the burst for genuine clicks/taps on the page, not form typing
      if (e.target.closest && e.target.closest('input, textarea, select, [role="dialog"]')) return;
      for (var i = 0; i < 9; i++) spawn(e.clientX, e.clientY, true);
      wake();
    }

    function onOver(e) {
      var hit = e.target.closest && e.target.closest('a, button, summary, [data-cursor-grow]');
      ring.target = hit ? 30 : 16;
      wake();
    }

    function onLeave() {
      mouse.inside = false;
      last.set = false;
      wake();
    }

    function bind() {
      if (!setup()) return;
      trail = fine.matches;
      window.addEventListener('pointermove', onMove, { passive: true });
      window.addEventListener('pointerdown', onDown, { passive: true });
      document.addEventListener('pointerover', onOver, { passive: true });
      document.documentElement.addEventListener('pointerleave', onLeave);
      window.addEventListener('resize', resize);
    }

    function unbind() {
      window.removeEventListener('pointermove', onMove);
      window.removeEventListener('pointerdown', onDown);
      document.removeEventListener('pointerover', onOver);
      document.documentElement.removeEventListener('pointerleave', onLeave);
      window.removeEventListener('resize', resize);
      cancelAnimationFrame(raf);
      raf = 0;
      items = [];
      if (ctx) ctx.clearRect(0, 0, w, h);
    }

    function apply() {
      unbind();
      if (!reduce.matches) bind();
    }

    reduce.addEventListener('change', apply);
    fine.addEventListener('change', apply);
    // The canvas persists across client-side navigations; re-grab it if it was swapped.
    document.addEventListener('astro:page-load', function () {
      if (document.getElementById('cursor-fx') !== canvas) apply();
    });
    apply();
  })();
</script>
