---
import Marquee from '@/components/Marquee.astro';
import Logo from '@/components/Logo.astro';
import { SITE } from '@/data/site';

interface Props {
  label?: string;
  marquee?: string[];
}

const {
  label = 'The Sulpice promise',
  marquee = ['Weddings', 'Corporate occasions', 'Celebrations', 'Ceremonies', 'Receptions'],
} = Astro.props;
---

<section class="relative overflow-hidden bg-teal-900 pt-28 text-cream md:pt-40" aria-label={label}>
  <div
    class="pointer-events-none absolute left-1/2 top-0 h-[36rem] w-[60rem] -translate-x-1/2 bg-[radial-gradient(closest-side,rgba(225,186,57,0.10),transparent)]"
    aria-hidden="true"
  ></div>

  <div class="container-luxe relative flex flex-col items-center text-center" data-reveal>
    <Logo width={150} />
    <p class="mono-label mt-10 text-gold-300">{label}</p>
    <p class="display-lg mt-10 max-w-5xl text-balance">
      Your dream is our <em class="text-gold-300">passion</em> — and your passion, our
      <em class="text-gold-300">mission.</em>
    </p>
    <p class="mt-10 max-w-md font-display text-xl italic leading-relaxed text-cream/70">
      {SITE.motto}
    </p>
    <div class="mt-14 max-w-2xl border-t border-cream/10 pt-10">
      <p class="mono-label text-[0.66rem] text-silver">Our vision</p>
      <p class="mt-4 text-[1rem] leading-[1.85] text-cream/75">
        To be the leading and most reliable functions décor, spatial styling, professional event
        education and hiring company in Zimbabwe, South Africa and the broader Southern African
        region.
      </p>
    </div>
  </div>

  <div class="relative mt-24 border-t border-cream/10 py-10 text-silver/35 md:mt-32 md:py-14">
    <Marquee items={marquee} duration={60} />
  </div>
</section>
