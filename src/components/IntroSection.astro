---
import { Image } from 'astro:assets';
import Button from '@/components/Button.astro';
import StatsCounters from '@/components/StatsCounters.tsx';
import { Icon } from 'astro-icon/components';
import { SITE } from '@/data/site';
import aboutStudio from '@/assets/about-studio.jpg';
import aboutDetail from '@/assets/about-detail.jpg';

const pillars = [
  'Everything under one roof — a full range of hire equipment to choose from',
  'Smooth delivery on our own trucks, right on time',
  'Weddings, corporates & birthdays — any event, big or small',
];
---

<section class="container-luxe section-pad" aria-labelledby="intro-heading">
  <div class="grid items-center gap-14 lg:grid-cols-2 lg:gap-20">
    <!-- Image collage -->
    <div class="relative" data-reveal>
      <div class="overflow-hidden rounded-2xl bg-cream-100 ring-1 ring-cream/5">
        <Image
          src={aboutStudio}
          alt="Event décor range on display at Sulpice Designs Decor"
          widths={[480, 720, 960]}
          sizes="(min-width: 1024px) 40vw, 90vw"
          loading="lazy"
          class="h-full w-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] hover:scale-[1.03]"
        />
      </div>
      <div
        class="absolute -bottom-8 -right-4 hidden w-44 overflow-hidden rounded-xl border-8 border-cream shadow-card sm:block md:w-56"
      >
        <Image
          src={aboutDetail}
          alt="Close-up of curated decor details and natural textures"
          widths={[220, 340, 440]}
          sizes="14rem"
          loading="lazy"
          class="h-full w-full object-cover"
        />
      </div>
      <div
        class="absolute -left-3 -top-6 hidden items-center gap-3 rounded-full bg-cream/90 px-5 py-3 shadow-card ring-1 ring-cream/10 backdrop-blur-md md:flex"
      >
        <Icon name="lucide:sparkles" class="h-5 w-5 text-gold-600" />
        <span class="font-mono text-xs uppercase tracking-[0.16em]">Est. 2008</span>
      </div>
    </div>

    <!-- Copy -->
    <div data-reveal style="--reveal-delay:120ms">
      <span class="mono-label mb-5 flex items-center gap-3 text-gold-300">
        <span class="index-num">00</span>
        <span class="h-px w-7 bg-gold-gradient" aria-hidden="true" />
        The company
      </span>
      <h2
        id="intro-heading"
        class="text-balance text-3xl leading-[1.1] text-cream sm:text-4xl md:text-[2.85rem]"
      >
        Every event, <span class="text-gold-gradient italic">beautifully dressed.</span>
      </h2>
      <p class="mt-6 text-base leading-relaxed text-muted md:text-lg">
        Established in 2008, Sulpice Designs Decor is a premium events décor and
        hiring services company. We design, supply, and deliver complete solutions —
        from tents and tables to luxurious linen and fresh flowers — for weddings,
        corporate events, and celebrations of every kind.
      </p>

      <ul class="mt-8 space-y-4">
        {
          pillars.map((pillar, i) => (
            <li class="flex items-start gap-4 text-sm text-cream/90 md:text-base">
              <span class="index-num pt-0.5">{String(i + 1).padStart(2, '0')}</span>
              <span class="mt-[0.62em] h-px w-4 shrink-0 bg-gold-gradient/60" aria-hidden="true" />
              {pillar}
            </li>
          ))
        }
      </ul>

      <div class="mt-10">
        <Button href="/about" variant="outline">
          More about us
          <Icon name="lucide:arrow-right" class="h-4 w-4" />
        </Button>
      </div>
    </div>
  </div>

  <!-- Stats -->
  <div class="mt-20 border-t border-cream/10 pt-12">
    <StatsCounters client:visible items={[...SITE.stats]} />
  </div>
</section>
