---
import { Image } from 'astro:assets';
import aboutStudio from '@/assets/about-studio.jpg';
import aboutDetail from '@/assets/about-detail.jpg';

const pillars = [
  { title: 'Under one roof', body: 'A complete hire range — one quotation, one point of contact.' },
  { title: 'Our own fleet', body: 'Delivered on our trucks, on time, right the first time.' },
  { title: 'Any occasion', body: 'Weddings, corporate functions and private celebrations, large or intimate.' },
];
---

<section class="surface-ivory section-pad" aria-labelledby="intro-heading">
  <div class="container-luxe">
    <div class="grid gap-16 lg:grid-cols-12 lg:gap-12">
      <!-- Copy -->
      <div class="lg:col-span-5 lg:pt-10" data-reveal>
        <span class="mono-label flex items-center gap-4 text-gold-300">
          <span class="h-px w-10 bg-gold/70" aria-hidden="true"></span>
          The house of Sulpice
        </span>
        <h2 id="intro-heading" class="display-lg mt-8 text-balance text-cream">
          Every event, <em class="text-gold-300">beautifully dressed.</em>
        </h2>
        <p class="mt-9 max-w-md text-[1.02rem] leading-[1.9] text-muted">
          Since 2008, Sulpice Designs Decor has dressed weddings, corporate occasions and
          private celebrations across Zimbabwe and South Africa — from the first tent peg to
          the final folded napkin. We design, supply, deliver and style, so that on the day,
          your only task is to be present.
        </p>

        <ol class="mt-12 max-w-md border-t border-cream/15">
          {
            pillars.map((pillar, i) => (
              <li class="grid grid-cols-[2.5rem_1fr] gap-x-2 border-b border-cream/15 py-5">
                <span class="index-num pt-0.5 text-lg text-gold-300">{['i', 'ii', 'iii'][i]}.</span>
                <span>
                  <span class="block font-display text-xl text-cream">{pillar.title}</span>
                  <span class="mt-1 block text-sm leading-relaxed text-muted">{pillar.body}</span>
                </span>
              </li>
            ))
          }
        </ol>

        <a href="/about" class="link-hairline mt-12 text-cream hover:text-gold-300">Discover our story</a>
      </div>

      <!-- Images -->
      <div class="relative lg:col-span-6 lg:col-start-7">
        <div class="overflow-hidden" data-reveal-clip>
          <Image
            src={aboutStudio}
            alt="Event décor range styled by Sulpice Designs Decor"
            widths={[600, 900, 1200]}
            sizes="(min-width: 1024px) 45vw, 92vw"
            loading="lazy"
            class="aspect-[4/5] w-full object-cover"
          />
        </div>
        <div
          class="absolute -bottom-14 -left-6 hidden w-[42%] border-[10px] border-ivory sm:block lg:-left-24"
          data-reveal
          style="--reveal-delay:250ms"
        >
          <Image
            src={aboutDetail}
            alt="Close-up of styled table details"
            widths={[300, 500]}
            sizes="18rem"
            loading="lazy"
            class="aspect-[3/4] w-full object-cover"
          />
        </div>
        <p class="mono-label mt-5 text-right text-[0.6rem] text-muted-400">
          Est. 2008 — Harare · Bulawayo · Fourways
        </p>
      </div>
    </div>

  </div>
</section>
