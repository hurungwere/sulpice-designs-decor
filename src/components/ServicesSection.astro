---
import SectionHeading from '@/components/SectionHeading.astro';
import ServicesShowcase from '@/components/ServicesShowcase.tsx';
import { Icon } from 'astro-icon/components';
import { toShowcaseItems } from '@/utils/services';

const items = await toShowcaseItems();
---

<section class="section-pad bg-cream-100" aria-labelledby="services-heading">
  <div class="container-luxe">
    <div class="flex flex-col gap-10 md:flex-row md:items-end md:justify-between">
      <SectionHeading
        id="services-heading"
        index="01"
        eyebrow="Services"
        title="A senior team for every kind of space."
        lead="Four core offerings, one philosophy — considered design that holds its value long after the trend has passed."
      />
      <a
        href="/services"
        class="group inline-flex items-center gap-2 whitespace-nowrap font-mono text-xs uppercase tracking-[0.16em] text-charcoal transition-colors hover:text-gold-600"
      >
        All services
        <Icon
          name="lucide:arrow-right"
          class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
        />
      </a>
    </div>

    <div class="mt-14 md:mt-20">
      <ServicesShowcase client:visible items={items} />
    </div>
  </div>
</section>
