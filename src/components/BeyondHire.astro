---
import { Image } from 'astro:assets';
import planning from '@/assets/profile/state-event-stage.jpg';
import printing from '@/assets/profile/printed-portrait-boards.jpg';
import sewa from '@/assets/profile/sewa-class.jpg';

const disciplines = [
  {
    kicker: 'Planning & coordination',
    title: 'Turnkey events',
    body: 'End-to-end management for weddings, anniversaries, launches and conferences — from first concept to final breakdown, with in-house technical and power expertise.',
    image: planning,
    alt: 'Staged ceremonial tent set-up for an institutional event by Sulpice Designs',
    href: '/contact',
  },
  {
    kicker: 'Printing & branding',
    title: 'Event print & branding',
    body: 'Custom backdrops, welcome signage, seating charts, printed stationery and corporate brand activations — produced in-house to match your décor.',
    image: printing,
    alt: 'Large-format printed portrait boards installed at an outdoor celebration',
    href: '/contact',
  },
  {
    kicker: 'SEWA Academy',
    title: 'Sulpice Events & Weddings Academy',
    body: 'Masterclasses and intakes in event styling, floral architecture, spatial planning, AI for décor design and décor business — for the next generation of planners.',
    image: sewa,
    alt: 'A SEWA masterclass intake with their instructors',
    href: '/about#sewa',
  },
];
---

<section class="section-pad" aria-labelledby="beyond-heading">
  <div class="container-luxe">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7" data-reveal>
        <span class="mono-label flex items-center gap-4 text-gold-300">
          <span class="h-px w-10 bg-gold/70" aria-hidden="true"></span>
          Beyond hire
        </span>
        <h2 id="beyond-heading" class="display-lg mt-8 text-balance text-cream">
          One house, <em class="text-gold-300">every discipline.</em>
        </h2>
      </div>
      <p
        class="max-w-sm text-[0.98rem] leading-[1.85] text-muted lg:col-span-4 lg:col-start-9"
        data-reveal
        style="--reveal-delay:120ms"
      >
        Alongside our décor and hire collection, we plan, print and teach — so a single call
        covers the whole occasion.
      </p>
    </div>

    <div class="mt-20 grid gap-x-10 gap-y-16 md:grid-cols-3">
      {
        disciplines.map((d, i) => (
          <a href={d.href} class="group block" data-reveal style={`--reveal-delay:${i * 110}ms`}>
            <div class="overflow-hidden bg-cream-50">
              <Image
                src={d.image}
                alt={d.alt}
                widths={[400, 512]}
                sizes="(min-width: 768px) 30vw, 92vw"
                loading="lazy"
                class="aspect-[4/3] w-full object-cover transition-transform duration-[1600ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.05]"
              />
            </div>
            <p class="mono-label mt-7 text-[0.66rem] text-gold-300">{d.kicker}</p>
            <h3 class="mt-3 font-display text-[1.9rem] leading-tight text-cream transition-colors duration-500 group-hover:text-gold-300">
              {d.title}
            </h3>
            <p class="mt-4 text-sm leading-[1.85] text-muted">{d.body}</p>
            <span class="link-hairline mt-7 text-cream group-hover:text-gold-300">Enquire</span>
          </a>
        ))
      }
    </div>
  </div>
</section>
