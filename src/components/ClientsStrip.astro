---
import Marquee from '@/components/Marquee.astro';
import { CLIENTS } from '@/data/site';

const marquee = [
  ...CLIENTS.map((c) => c.short),
  'Churches & faith organisations',
  'Private couples & families',
];
---

<section class="section-pad overflow-hidden" aria-labelledby="clients-heading">
  <div class="container-luxe">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7" data-reveal>
        <span class="mono-label flex items-center gap-4 text-gold-300">
          <span class="h-px w-10 bg-gold/70" aria-hidden="true"></span>
          Trusted by
        </span>
        <h2 id="clients-heading" class="display-lg mt-8 text-balance text-cream">
          Institutions, brands <em class="text-gold-300">&amp; families alike.</em>
        </h2>
      </div>
      <p
        class="max-w-sm text-[0.98rem] leading-[1.85] text-muted lg:col-span-4 lg:col-start-9"
        data-reveal
        style="--reveal-delay:120ms"
      >
        For eighteen years, government institutions, corporate and automotive brands, faith
        organisations and private clients have trusted us with their most important occasions.
      </p>
    </div>

    <ul class="mt-20 grid border-l border-t border-cream/10 sm:grid-cols-2 lg:grid-cols-3">
      {
        CLIENTS.map((client, i) => (
          <li
            class="group flex min-h-[11rem] flex-col justify-between border-b border-r border-cream/10 p-8 transition-colors duration-700 hover:bg-cream-50 md:p-10"
            data-reveal
            style={`--reveal-delay:${(i % 3) * 90}ms`}
          >
            <span class="index-num text-lg text-silver-400">{String(i + 1).padStart(2, '0')}</span>
            <span>
              <span class="block font-display text-[1.7rem] leading-tight text-cream transition-colors duration-500 group-hover:text-gold-300">
                {client.name}
              </span>
              <span class="mono-label mt-3 block text-[0.66rem] text-muted-400">{client.scope}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="mt-20 text-silver/25">
    <Marquee items={marquee} duration={70} />
  </div>
</section>
