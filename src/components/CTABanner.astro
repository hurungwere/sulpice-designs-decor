---
import { Image } from 'astro:assets';
import Button from '@/components/Button.astro';
import { Icon } from 'astro-icon/components';
import { SITE } from '@/data/site';
import ctaImage from '@/assets/cta.jpg';

interface Props {
  title?: string;
  lead?: string;
  image?: ImageMetadata;
  alt?: string;
}
const {
  title = 'Planning your dream event?',
  lead = "Tell us your date, venue, and guest list — we'll prepare a detailed, no-obligation quotation, with everything under one roof.",
  image = ctaImage,
  alt = 'Elegant event setting styled by Sulpice Designs Decor',
} = Astro.props;
---

<section class="container-luxe py-16 md:py-24" aria-labelledby="cta-heading">
  <div
    class="relative isolate overflow-hidden rounded-[2.5rem] bg-teal-900 px-7 py-16 text-cream shadow-soft md:px-16 md:py-20"
    data-reveal
  >
    <Image
      src={image}
      alt={alt}
      widths={[768, 1280, 1600]}
      sizes="100vw"
      loading="lazy"
      class="absolute inset-0 -z-10 h-full w-full object-cover opacity-20"
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-teal-900/95 via-teal-900/80 to-teal-800/55" aria-hidden="true"></div>
    <span
      class="absolute inset-x-16 top-0 h-px bg-gold-gradient/70"
      aria-hidden="true"
    />
    <span
      class="pointer-events-none absolute -bottom-24 -right-14 -z-10 select-none font-display text-[16rem] leading-none text-cream/[0.04]"
      aria-hidden="true"
    >
      S
    </span>

    <div class="mx-auto max-w-2xl text-center">
      <span class="eyebrow justify-center text-gold-300">
        <span class="h-px w-8 bg-gold-300" aria-hidden="true" />
        Let's begin
      </span>
      <h2
        id="cta-heading"
        class="mt-5 text-balance font-display text-3xl leading-tight text-white sm:text-4xl md:text-5xl"
      >
        {title}
      </h2>
      <p class="mx-auto mt-5 max-w-xl text-base leading-relaxed text-cream/80">{lead}</p>

      <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
        <Button href="/contact" variant="gold" size="lg">
          Get a quotation
          <Icon name="lucide:arrow-right" class="h-4 w-4" />
        </Button>
        <Button href={`tel:${SITE.phoneHref}`} variant="light" size="lg">
          <Icon name="lucide:phone" class="h-4 w-4" />
          {SITE.phone}
        </Button>
      </div>

      <p class="mt-6 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs text-cream/60">
        <span class="flex items-center gap-1.5">
          <Icon name="lucide:check" class="h-3.5 w-3.5 text-gold-300" /> No obligation
        </span>
        <span class="flex items-center gap-1.5">
          <Icon name="lucide:check" class="h-3.5 w-3.5 text-gold-300" /> Replies within 24 hours
        </span>
        <span class="flex items-center gap-1.5">
          <Icon name="lucide:check" class="h-3.5 w-3.5 text-gold-300" /> Own-fleet delivery &amp; styling
        </span>
        <span class="flex items-center gap-1.5">
          <Icon name="lucide:check" class="h-3.5 w-3.5 text-gold-300" /> Zimbabwe · South Africa · Southern Africa
        </span>
      </p>
    </div>
  </div>
</section>
