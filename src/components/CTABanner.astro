---
import { Image } from 'astro:assets';
import Button from '@/components/Button.astro';
import { SITE } from '@/data/site';
import ctaImage from '@/assets/cta.jpg';

interface Props {
  title?: string;
  lead?: string;
  image?: ImageMetadata;
  alt?: string;
}
const {
  title = 'Let us dress your next occasion.',
  lead = "Tell us your date, venue, and guest list — we'll prepare a detailed, no-obligation quotation, with everything under one roof.",
  image = ctaImage,
  alt = 'Elegant event setting styled by Sulpice Designs Decor',
} = Astro.props;
---

<section
  class="relative isolate overflow-hidden bg-teal-900 py-36 text-white md:py-52"
  aria-labelledby="cta-heading"
>
  <Image
    src={image}
    alt={alt}
    widths={[768, 1280, 1920, 2400]}
    sizes="100vw"
    loading="lazy"
    class="absolute inset-0 -z-10 h-full w-full object-cover"
  />
  <div
    class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_center,rgba(3,27,31,0.6)_0%,rgba(3,27,31,0.88)_75%)]"
    aria-hidden="true"
  ></div>

  <div class="container-luxe flex flex-col items-center text-center" data-reveal>
    <span class="mono-label flex items-center gap-4 text-gold-300">
      <span class="h-px w-10 bg-gold/70" aria-hidden="true"></span>
      Begin the conversation
      <span class="h-px w-10 bg-gold/70" aria-hidden="true"></span>
    </span>
    <h2 id="cta-heading" class="display-lg mt-9 max-w-4xl text-balance">
      {title}
    </h2>
    <p class="mt-8 max-w-xl text-[1.02rem] leading-[1.85] text-white/75">{lead}</p>

    <div class="mt-12 flex flex-col items-center gap-7 sm:flex-row sm:gap-10">
      <Button href="/contact" variant="gold" size="lg">Request a quote</Button>
      <a href={`tel:${SITE.phoneHref}`} class="link-hairline text-white hover:text-gold-300">
        Or call {SITE.phone}
      </a>
    </div>

    <p class="mono-label mt-14 text-[0.6rem] text-white/50">
      No obligation · Replies within 24 hours
    </p>
  </div>
</section>

