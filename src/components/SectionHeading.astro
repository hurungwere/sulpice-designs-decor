---
interface Props {
  eyebrow?: string;
  index?: string;
  title: string;
  lead?: string;
  align?: 'left' | 'center';
  tone?: 'dark' | 'light';
  class?: string;
  id?: string;
}

const {
  eyebrow,
  index,
  title,
  lead,
  align = 'left',
  tone = 'dark',
  class: className = '',
  id,
} = Astro.props;

const centered = align === 'center';
const leadColor = tone === 'light' ? 'text-cream/70' : 'text-muted';
---

<div
  class:list={[
    'flex max-w-3xl flex-col',
    centered ? 'mx-auto items-center text-center' : 'items-start',
    className,
  ]}
  data-reveal
>
  {
    eyebrow && (
      <span class="mono-label mb-7 flex items-center gap-4 text-gold-300">
        {index && <span class="index-num text-gold-300">{index}</span>}
        <span class="h-px w-10 bg-gold/70" aria-hidden="true" />
        {eyebrow}
      </span>
    )
  }
  <h2 id={id} class="display-md text-balance text-cream">
    {title}
  </h2>
  {
    lead && (
      <p
        class:list={[
          'mt-7 max-w-xl text-base leading-[1.85] md:text-[1.05rem]',
          leadColor,
          centered && 'mx-auto',
        ]}
      >
        {lead}
      </p>
    )
  }
</div>
