---
import { getCollection } from 'astro:content';
import WorkGrid from '@/components/WorkGrid.astro';
import { toGalleryItems } from '@/utils/portfolio';

const featured = (await getCollection('projects'))
  .filter((entry) => entry.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);

const items = await toGalleryItems(featured);
---

<section class="section-pad" aria-labelledby="work-heading">
  <div class="container-luxe">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-8" data-reveal>
        <span class="mono-label flex items-center gap-4 text-gold-300">
          <span class="h-px w-10 bg-gold/70" aria-hidden="true"></span>
          Selected events
        </span>
        <h2 id="work-heading" class="display-lg mt-8 text-balance text-cream">
          Recent occasions, <em class="text-gold-300">dressed by us.</em>
        </h2>
      </div>
      <div class="lg:col-span-3 lg:col-start-10 lg:justify-self-end" data-reveal>
        <a href="/portfolio" class="link-hairline text-cream hover:text-gold-300">View the portfolio</a>
      </div>
    </div>

    <WorkGrid items={items} class="mt-20 md:mt-28" />
  </div>
</section>
