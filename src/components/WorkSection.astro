---
import { getCollection } from 'astro:content';
import SectionHeading from '@/components/SectionHeading.astro';
import WorkGrid from '@/components/WorkGrid.astro';
import { Icon } from 'astro-icon/components';
import { toGalleryItems } from '@/utils/portfolio';

const featured = (await getCollection('projects'))
  .filter((entry) => entry.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);

const items = await toGalleryItems(featured);
---

<section class="section-pad" aria-labelledby="work-heading">
  <div class="container-luxe">
    <div class="flex flex-col gap-10 md:flex-row md:items-end md:justify-between">
      <SectionHeading
        id="work-heading"
        index="03"
        eyebrow="Selected work"
        title="Recent events we're proud of."
        lead="From tent to tablecloth — recent weddings, corporate functions, and celebrations we've dressed and delivered."
      />
      <a
        href="/portfolio"
        class="group inline-flex items-center gap-2 whitespace-nowrap rounded-full border border-cream/20 px-5 py-2.5 font-mono text-xs uppercase tracking-[0.16em] text-cream transition-colors hover:border-gold-600 hover:text-gold-600"
      >
        All events
        <Icon
          name="lucide:arrow-right"
          class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
        />
      </a>
    </div>

    <WorkGrid items={items} class="mt-14 md:mt-20" />
  </div>
</section>
