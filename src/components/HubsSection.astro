---
import { SITE } from '@/data/site';

const hubs = SITE.hubs.map((hub, i) => ({
  ...hub,
  address: SITE.showrooms[i],
  phone: SITE.branchContacts[i].phone,
  phoneHref: SITE.branchContacts[i].phoneHref,
  country: i === 2 ? 'South Africa' : 'Zimbabwe',
}));
---

<section class="bg-teal-600 py-24 text-white md:py-32" aria-labelledby="hubs-heading">
  <div class="container-luxe">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7" data-reveal>
        <span class="mono-label flex items-center gap-4 text-white">
          <span class="h-px w-10 bg-gold/70" aria-hidden="true"></span>
          Our regional network
        </span>
        <h2 id="hubs-heading" class="display-lg mt-8 text-balance">
          Three hubs, <em>two countries.</em>
        </h2>
      </div>
      <p
        class="max-w-sm text-[0.98rem] leading-[1.85] text-white lg:col-span-4 lg:col-start-9"
        data-reveal
        style="--reveal-delay:120ms"
      >
        Creative concepts from Johannesburg, operations and training from Harare, and a branch
        in Bulawayo — serving events across Southern Africa.
      </p>
    </div>

    <ol class="mt-16 grid border-t border-white/25 md:grid-cols-3">
      {
        hubs.map((hub, i) => (
          <li
            class="flex flex-col border-b border-white/25 py-10 md:border-b-0 md:border-l md:px-8 md:first:border-l-0 md:first:pl-0"
            data-reveal
            style={`--reveal-delay:${i * 100}ms`}
          >
            <span class="mono-label text-[0.66rem] text-white">{hub.country}</span>
            <h3 class="mt-5 font-display text-[2rem] leading-tight">{hub.name}</h3>
            <p class="mt-2 font-display text-lg italic text-white/90">{hub.role}</p>
            <p class="mt-6 text-[0.95rem] leading-relaxed text-white">{hub.address}</p>
            <div class="mt-auto flex flex-wrap gap-x-7 gap-y-3 pt-8">
              <a href={`tel:${hub.phoneHref}`} class="link-hairline text-white hover:text-gold-300">
                {hub.phone}
              </a>
              <a
                href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(hub.mapQuery)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="link-hairline text-white hover:text-gold-300"
              >
                Directions
              </a>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
