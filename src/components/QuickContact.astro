---
import { Icon } from 'astro-icon/components';
import { SITE } from '@/data/site';

const waNumber = SITE.whatsapp.replace(/\D/g, '');
const waText = encodeURIComponent(
  "Hello Sulpice Designs, I'd like a quotation for my event.\n\nDate:\nVenue:\nGuests:",
);
const waHref = `https://wa.me/${waNumber}?text=${waText}`;

// WhatsApp glyph (brand mark), drawn inline so no icon pack is needed.
const waPath =
  'M19.05 4.91A9.82 9.82 0 0 0 12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.91-7.01Zm-7.01 15.24h-.01a8.23 8.23 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.22-8.23 8.22Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.25-.64.8-.78.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.13-.15.17-.25.25-.42.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.23.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.14-1.18-.06-.1-.22-.16-.47-.28Z';
---

<!-- Desktop: discreet floating WhatsApp button -->
<a
  id="wa-float"
  href={waHref}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chat with Sulpice Designs on WhatsApp"
  class="group fixed bottom-7 right-7 z-[58] hidden h-14 items-center overflow-hidden border border-gold/50 bg-teal-900/90 text-gold-300 shadow-[0_20px_40px_-20px_rgba(0,0,0,0.7)] backdrop-blur-md pointer-events-none translate-y-4 opacity-0 transition-[border-color,background-color,color,opacity,transform] duration-500 hover:border-gold hover:bg-gold hover:text-ink data-[show=true]:pointer-events-auto data-[show=true]:translate-y-0 data-[show=true]:opacity-100 lg:flex"
  data-show="false"
  tabindex="-1"
  transition:persist
>
  <span class="flex h-14 w-14 shrink-0 items-center justify-center">
    <svg viewBox="0 0 24 24" class="h-6 w-6" fill="currentColor" aria-hidden="true"><path d={waPath} /></svg>
  </span>
  <span
    class="max-w-0 whitespace-nowrap pr-0 text-[0.66rem] uppercase tracking-[0.28em] opacity-0 transition-all duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:max-w-[12rem] group-hover:pr-6 group-hover:opacity-100 group-focus-visible:max-w-[12rem] group-focus-visible:pr-6 group-focus-visible:opacity-100"
  >
    Chat on WhatsApp
  </span>
</a>

<!-- Mobile: fixed action bar -->
<nav
  id="quick-bar"
  aria-label="Quick contact"
  class="fixed inset-x-0 bottom-0 z-[58] grid grid-cols-3 border-t border-cream/10 bg-teal-900/95 pb-[env(safe-area-inset-bottom)] text-cream backdrop-blur-xl transition-transform duration-500 data-[hidden=true]:translate-y-full lg:hidden"
  transition:persist
>
  <a
    href={`tel:${SITE.phoneHref}`}
    class="flex h-14 items-center justify-center gap-2.5 text-[0.66rem] uppercase tracking-[0.24em] text-cream/85 active:bg-cream/5"
  >
    <Icon name="lucide:phone" class="h-4 w-4 text-gold-300" />
    Call
  </a>
  <a
    href={waHref}
    target="_blank"
    rel="noopener noreferrer"
    class="flex h-14 items-center justify-center gap-2.5 border-x border-cream/10 text-[0.66rem] uppercase tracking-[0.24em] text-cream/85 active:bg-cream/5"
  >
    <svg viewBox="0 0 24 24" class="h-4 w-4 text-gold-300" fill="currentColor" aria-hidden="true"><path d={waPath} /></svg>
    WhatsApp
  </a>
  <a
    href="/contact#enquiry"
    class="flex h-14 items-center justify-center bg-gold-gradient text-[0.66rem] uppercase tracking-[0.24em] text-ink active:brightness-110"
  >
    Get a quote
  </a>
</nav>

<script is:inline>
  (function () {
    if (window.__sulpiceQuickBound) return;
    window.__sulpiceQuickBound = true;
    // Keep the bar out of the way of the on-screen keyboard while typing.
    function sync(hidden) {
      var bar = document.getElementById('quick-bar');
      if (bar) bar.dataset.hidden = hidden ? 'true' : 'false';
    }
    document.addEventListener('focusin', function (e) {
      if (e.target.matches && e.target.matches('input, textarea, select')) sync(true);
    });
    // Desktop WhatsApp button: appear once the visitor has scrolled past the hero.
    function float() {
      var btn = document.getElementById('wa-float');
      if (!btn) return;
      var show = window.scrollY > window.innerHeight * 0.7;
      if ((btn.dataset.show === 'true') === show) return;
      btn.dataset.show = show ? 'true' : 'false';
      btn.tabIndex = show ? 0 : -1;
    }
    window.addEventListener('scroll', float, { passive: true });
    document.addEventListener('astro:page-load', float);
    float();

    document.addEventListener('focusout', function () {
      setTimeout(function () {
        var a = document.activeElement;
        sync(!!(a && a.matches && a.matches('input, textarea, select')));
      }, 50);
    });
  })();
</script>
