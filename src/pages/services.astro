---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Button from '@/components/Button.astro';
import CTABanner from '@/components/CTABanner.astro';
import { Icon } from 'astro-icon/components';
import { SERVICES, PROCESS } from '@/data/services';
import heroImage from '@/assets/service-residential.jpg';

const faqs = [
  {
    q: 'Where do you work?',
    a: 'Our showrooms are in Harare and Bulawayo, Zimbabwe, and Fourways, Johannesburg, South Africa — and we deliver events across the wider southern African region for private clients.',
  },
  {
    q: 'What if we already have some furniture or décor?',
    a: 'No problem at all. We love to work around pieces you already own — hire the rest around them to build a complete, cohesive look.',
  },
  {
    q: 'How are your quotations structured?',
    a: 'Quotations are free, detailed, and tailored to your date, venue, and guest count. With everything under one roof, you get one quote and one point of contact.',
  },
  {
    q: 'How much notice do you need?',
    a: 'Most hires need only a few days of notice. For larger or destination events, the earlier we plan, the smoother delivery and styling will be.',
  },
];
---

<BaseLayout
  title="Design Services"
  description="Tents, tables, chairs, crockery, linen, and florals for hire from Sulpice Designs Decor across Zimbabwe and South Africa — weddings, corporate events, and every celebration."
>
  <PageHero
    eyebrow="What we hire"
    title="Everything for your event, under one roof."
    lead="Tents, tables, crockery, luxurious linen, and florals — four product lines, one quotation, delivered and styled by our own crew."
    image={heroImage}
    alt="Elegantly styled event setting by Sulpice Designs Decor"
    crumb="Services"
  />

  <!-- Service detail -->
  <section class="container-luxe space-y-24 py-24 md:space-y-32 md:py-32" aria-label="Service details">
    {
      SERVICES.map((service, i) => {
        const reversed = i % 2 === 1;
        return (
          <article id={service.slug} class="scroll-mt-28">
            <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
              <div class:list={['relative', reversed && 'lg:order-2']} data-reveal>
                <div class="overflow-hidden rounded-2xl ring-1 ring-cream/5">
                  <Image
                    src={service.image}
                    alt={`${service.title} by Sulpice Designs Decor`}
                    widths={[480, 720, 960]}
                    sizes="(min-width: 1024px) 45vw, 90vw"
                    loading="lazy"
                    class="h-full w-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] hover:scale-[1.03]"
                  />
                </div>
                <span class="absolute left-5 top-5 inline-flex items-center gap-2 rounded-full bg-cream/90 px-4 py-2 font-mono text-[0.68rem] font-medium uppercase tracking-[0.16em] text-teal-700 backdrop-blur-sm">
                  <Icon name={service.icon} class="h-4 w-4 text-gold-600" />
                  {service.tagline}
                </span>
                <span class="bg-gold-gradient absolute right-5 top-5 inline-flex items-center gap-1.5 rounded-full px-4 py-2 font-mono text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-ink shadow-lg shadow-gold-600/25">
                  <Icon name="lucide:star" class="h-3.5 w-3.5" />
                  {service.badge}
                </span>
              </div>

              <div class:list={[reversed && 'lg:order-1']} data-reveal style="--reveal-delay:120ms">
                <p class="mono-label text-gold-300">
                  0{i + 1} — {service.title}
                </p>
                <h2 class="mt-4 text-balance text-3xl leading-tight text-cream sm:text-4xl">
                  {service.title}
                </h2>
                <p class="mt-4 text-base leading-relaxed text-muted md:text-lg">
                  {service.description}
                </p>

                <ul class="mt-7 grid gap-3 sm:grid-cols-2">
                  {service.features.map((feature) => (
                    <li class="flex items-start gap-2.5 text-sm text-cream/90">
                      <Icon name="lucide:check" class="mt-0.5 h-4 w-4 shrink-0 text-gold-600" />
                      {feature}
                    </li>
                  ))}
                </ul>

                <dl class="mt-8 flex flex-wrap gap-x-10 gap-y-4 border-t border-cream/10 pt-6">
                  <div>
                    <dt class="text-[0.7rem] font-semibold uppercase tracking-[0.18em] text-muted">
                      Investment
                    </dt>
                    <dd class="mt-1 font-display text-xl text-cream">{service.price}</dd>
                  </div>
                  <div>
                    <dt class="text-[0.7rem] font-semibold uppercase tracking-[0.18em] text-muted">
                      Typical timeline
                    </dt>
                    <dd class="mt-1 font-display text-xl text-cream">{service.duration}</dd>
                  </div>
                </dl>

                <div class="mt-8">
                  <Button href="/contact">
                    Enquire about {service.title.toLowerCase()}
                    <Icon name="lucide:arrow-right" class="h-4 w-4" />
                  </Button>
                </div>
              </div>
            </div>
          </article>
        );
      })
    }
  </section>

  <!-- Types of events -->
  <section class="container-luxe pb-24 md:pb-32" aria-labelledby="events-heading">
    <SectionHeading
      id="events-heading"
      index="02"
      eyebrow="Types of events"
      title="Every celebration, styled with care."
      lead="From white-tie weddings to casual garden bashes — formal or casual, we customise a complete solution for any event, big or small."
      class="mb-14"
    />
    <div class="grid gap-px overflow-hidden rounded-2xl border border-cream/10 bg-cream/10 sm:grid-cols-2 lg:grid-cols-4">
      {
        [
          { icon: 'lucide:heart', title: 'Weddings', body: 'Ceremonies & receptions' },
          { icon: 'lucide:star', title: 'Birthday bashes', body: 'Big or intimate' },
          { icon: 'lucide:building-2', title: 'Corporate events', body: 'End-of-year parties, launches & awards' },
          { icon: 'lucide:sparkles', title: 'Any celebration', body: 'Formal or casual — customised to you' },
        ].map((type, i) => (
          <div
            class="bg-cream-50 p-8 transition-colors duration-500 hover:bg-cream-100"
            data-reveal
            style={`--reveal-delay:${i * 90}ms`}
          >
            <span class="bg-gold-gradient inline-flex h-12 w-12 items-center justify-center rounded-full text-ink">
              <Icon name={type.icon} class="h-5 w-5" />
            </span>
            <h3 class="mt-6 font-display text-xl text-cream">{type.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{type.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Process -->
  <section class="bg-teal-900 section-pad text-cream" aria-labelledby="process-heading">
    <div class="container-luxe">
      <SectionHeading
        id="process-heading"
        index="03"
        eyebrow="How we work"
        title="Hired, delivered, styled — in four steps."
        lead="We value time and clear communication. One clear rhythm from first enquiry to the day of your event."
        tone="light"
        class="mb-16"
      />

      <ol class="grid gap-px overflow-hidden rounded-2xl border border-cream/15 bg-cream/15 md:grid-cols-2 lg:grid-cols-4">
        {
          PROCESS.map((step, i) => (
            <li
              class="group bg-teal-900 p-8 transition-colors duration-500 hover:bg-teal-800"
              data-reveal
              style={`--reveal-delay:${i * 100}ms`}
            >
              <span class="font-mono text-xs uppercase tracking-[0.16em] text-gold-300">
                {step.step} / 04
              </span>
              <h3 class="mt-12 font-display text-2xl text-cream">{step.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-cream/70">{step.description}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- FAQ -->
  <section class="container-luxe py-24 md:py-32" aria-labelledby="faq-heading">
    <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <SectionHeading
        id="faq-heading"
        eyebrow="Good to know"
        title="Questions, answered"
        lead="Still curious? We're always happy to talk it through — no obligation."
      />

      <div class="divide-y divide-cream/10 border-y border-cream/10">
        {
          faqs.map((faq, i) => (
            <details class="group py-5" data-reveal style={`--reveal-delay:${i * 80}ms`}>
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-left font-display text-lg text-cream">
                {faq.q}
                <Icon
                  name="lucide:plus"
                  class="h-5 w-5 shrink-0 text-gold-600 transition-transform duration-300 group-open:rotate-45"
                />
              </summary>
              <p class="mt-3 text-sm leading-relaxed text-muted">{faq.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <CTABanner
    title="Not sure which service fits?"
    lead="Send us a few details and a photo of your space. We'll recommend the right path — and a realistic budget."
  />
</BaseLayout>
