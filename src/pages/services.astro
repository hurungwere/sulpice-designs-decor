---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Button from '@/components/Button.astro';
import CTABanner from '@/components/CTABanner.astro';
import BeyondHire from '@/components/BeyondHire.astro';
import { Icon } from 'astro-icon/components';
import { SERVICES, PROCESS } from '@/data/services';
import { INVENTORY } from '@/data/site';
import heroImage from '@/assets/service-residential.jpg';

const faqs = [
  {
    q: 'Where do you work?',
    a: 'Our headquarters is in Eastlea, Harare, with an operations branch in Bulawayo and our creative design hub in Broadacres, Fourways, Johannesburg — and we deliver events across the wider Southern African region.',
  },
  {
    q: 'What if we already have some furniture or décor?',
    a: 'No problem at all. We love to work around pieces you already own — hire the rest around them to build a complete, cohesive look.',
  },
  {
    q: 'How are your quotations structured?',
    a: 'Quotations are free, detailed, and tailored to your date, venue, and guest count. With everything under one roof, you get one quote and one point of contact.',
  },
  {
    q: 'How much notice do you need?',
    a: 'Most hires need only a few days of notice. For larger or destination events, the earlier we plan, the smoother delivery and styling will be.',
  },
];
---

<BaseLayout
  transparentHeader
  title="Design Services"
  description="Tents, tables, chairs, crockery, linen, and florals for hire from Sulpice Designs Decor across Zimbabwe and South Africa — weddings, corporate events, and every celebration."
>
  <PageHero
    eyebrow="What we hire"
    title="Everything for your event, under one roof."
    lead="Tents, tables, crockery, luxurious linen, and florals — four product lines, one quotation, delivered and styled by our own crew."
    image={heroImage}
    alt="Elegantly styled event setting by Sulpice Designs Decor"
    crumb="Services"
  />

  <!-- Service detail -->
  <section class="container-luxe section-pad space-y-32 md:space-y-48" aria-label="The collection">
    {
      SERVICES.map((service, i) => {
        const reversed = i % 2 === 1;
        return (
          <article id={service.slug} class="scroll-mt-28">
            <div class="grid items-center gap-14 lg:grid-cols-12 lg:gap-12">
              <figure
                class:list={['lg:col-span-6', reversed ? 'lg:order-2 lg:col-start-7' : '']}
              >
                <div class="overflow-hidden bg-cream-50" data-reveal-clip>
                  <Image
                    src={service.image}
                    alt={`${service.title} by Sulpice Designs Decor`}
                    widths={[600, 900, 1200]}
                    sizes="(min-width: 1024px) 45vw, 92vw"
                    loading="lazy"
                    class="aspect-[4/5] w-full object-cover transition-transform duration-[1600ms] ease-[cubic-bezier(0.22,1,0.36,1)] hover:scale-[1.04]"
                  />
                </div>
                <figcaption class="mono-label mt-5 text-[0.66rem] text-muted-400">
                  {service.tagline}
                </figcaption>
              </figure>

              <div
                class:list={[
                  'lg:col-span-5',
                  reversed ? 'lg:order-1 lg:col-start-1' : 'lg:col-start-8',
                ]}
                data-reveal
                style="--reveal-delay:120ms"
              >
                <p class="flex items-center gap-4 text-gold-300">
                  <span class="index-num text-lg text-gold-300">{String(i + 1).padStart(2, '0')}</span>
                  <span class="h-px w-10 bg-gold/70" aria-hidden="true" />
                </p>
                <h2 class="display-md mt-6 text-balance text-cream">{service.title}</h2>
                <p class="mt-7 text-[1.02rem] leading-[1.85] text-muted">{service.description}</p>

                <ul class="mt-10 border-t border-cream/10">
                  {service.features.map((feature) => (
                    <li class="flex items-center gap-4 border-b border-cream/10 py-3.5 text-[0.95rem] text-cream/85">
                      <span class="diamond" aria-hidden="true" />
                      {feature}
                    </li>
                  ))}
                </ul>

                <dl class="mt-10 grid grid-cols-2 gap-6">
                  <div>
                    <dt class="mono-label text-[0.66rem] text-muted-400">Pricing</dt>
                    <dd class="mt-2 font-display text-2xl text-cream">{service.price}</dd>
                  </div>
                  <div>
                    <dt class="mono-label text-[0.66rem] text-muted-400">Timeline</dt>
                    <dd class="mt-2 font-display text-2xl text-cream">{service.duration}</dd>
                  </div>
                </dl>

                <div class="mt-12">
                  <Button href="/contact" variant="outline" aria-label={`Enquire about ${service.title}`}>
                    Enquire
                  </Button>
                </div>
              </div>
            </div>
          </article>
        );
      })
    }
  </section>

  <!-- Inventory -->
  <section class="container-luxe pb-32 md:pb-44" aria-labelledby="inventory-heading">
    <div class="grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <SectionHeading
          id="inventory-heading"
          eyebrow="The inventory"
          title="What is in the warehouse."
          lead="A high-specification range, kept current with the latest trends — all owned, maintained and delivered by us."
        />
      </div>
      <dl class="border-t border-cream/15 lg:col-span-7 lg:col-start-6">
        {
          INVENTORY.map((row, i) => (
            <div
              class="grid gap-2 border-b border-cream/15 py-6 sm:grid-cols-[14rem_1fr] sm:gap-8"
              data-reveal
              style={`--reveal-delay:${i * 60}ms`}
            >
              <dt class="font-display text-2xl text-cream">{row.category}</dt>
              <dd class="text-[0.95rem] leading-[1.8] text-muted sm:pt-1.5">{row.items}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Types of events -->
  <section class="surface-ivory section-pad" aria-labelledby="events-heading">
    <div class="container-luxe">
      <SectionHeading
        id="events-heading"
        eyebrow="Occasions"
        title="Every celebration, styled with care."
        lead="From white-tie weddings to relaxed garden gatherings — formal or casual, we tailor a complete solution to any event, large or intimate."
        class="mb-20"
      />
      <div class="grid border-t border-cream/15 sm:grid-cols-2 lg:grid-cols-4">
        {
          [
            { title: 'Weddings', body: 'Ceremonies & receptions' },
            { title: 'Birthdays', body: 'Milestones, large or intimate' },
            { title: 'Corporate', body: 'Year-end functions, launches & awards' },
            { title: 'Any celebration', body: 'Formal or casual — tailored to you' },
          ].map((type, i) => (
            <div
              class="border-b border-cream/15 py-10 sm:pr-8 lg:border-b-0 lg:border-l lg:px-8 lg:first:border-l-0 lg:first:pl-0"
              data-reveal
              style={`--reveal-delay:${i * 90}ms`}
            >
              <span class="index-num text-lg text-gold-300">{['i', 'ii', 'iii', 'iv'][i]}.</span>
              <h3 class="mt-8 font-display text-3xl text-cream">{type.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-muted">{type.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="bg-teal-900 section-pad text-cream" aria-labelledby="process-heading">
    <div class="container-luxe">
      <SectionHeading
        id="process-heading"
        eyebrow="How we work"
        title="Hired, delivered, styled — in four steps."
        lead="We value your time and clear communication: one calm rhythm from first enquiry to the day itself."
        tone="light"
        class="mb-20"
      />

      <ol class="grid gap-y-14 md:grid-cols-2 lg:grid-cols-4 lg:gap-x-10">
        {
          PROCESS.map((step, i) => (
            <li class="border-t border-cream/15 pt-8" data-reveal style={`--reveal-delay:${i * 100}ms`}>
              <span class="font-display text-6xl font-light italic leading-none text-gold-300">
                {step.step}
              </span>
              <h3 class="mt-8 font-display text-3xl text-cream">{step.title}</h3>
              <p class="mt-3 max-w-xs text-sm leading-[1.8] text-cream/65">{step.description}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <BeyondHire />

  <!-- FAQ -->
  <section class="container-luxe section-pad" aria-labelledby="faq-heading">
    <div class="grid gap-14 lg:grid-cols-[0.8fr_1.2fr] lg:gap-24">
      <SectionHeading
        id="faq-heading"
        eyebrow="Good to know"
        title="Questions, answered"
        lead="Still curious? We're always happy to talk it through — no obligation."
      />

      <div class="divide-y divide-cream/10 border-y border-cream/10">
        {
          faqs.map((faq, i) => (
            <details class="group py-7" data-reveal style={`--reveal-delay:${i * 80}ms`}>
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-left font-display text-2xl text-cream transition-colors hover:text-gold-300 [&::-webkit-details-marker]:hidden">
                {faq.q}
                <Icon
                  name="lucide:plus"
                  class="h-5 w-5 shrink-0 text-gold-300 transition-transform duration-500 group-open:rotate-45"
                />
              </summary>
              <p class="mt-4 max-w-xl text-[0.95rem] leading-[1.85] text-muted">{faq.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <CTABanner
    title="Not sure which service fits?"
    lead="Send us a few details and a photo of your space. We'll recommend the right path — and a realistic budget."
  />
</BaseLayout>
