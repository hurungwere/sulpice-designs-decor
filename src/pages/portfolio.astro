---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import PortfolioGallery from '@/components/PortfolioGallery.tsx';
import CTABanner from '@/components/CTABanner.astro';
import { toGalleryItems } from '@/utils/portfolio';
import heroImage from '@/assets/hero-3.jpg';

const entries = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);
const items = await toGalleryItems(entries);

const counts = entries.reduce<Record<string, number>>((acc, entry) => {
  acc[entry.data.category] = (acc[entry.data.category] ?? 0) + 1;
  return acc;
}, {});
---

<BaseLayout
  title="Portfolio"
  description="A selection of recent weddings, corporate events, and celebrations styled and delivered by Sulpice Designs Decor — dressed from tent to tablecloth."
>
  <PageHero
    eyebrow="Portfolio"
    title="Recent events, styled and delivered."
    lead="A selection of weddings, corporate functions, and celebrations across Zimbabwe and South Africa — dressed from tent to tablecloth."
    image={heroImage}
    alt="Event styling by Sulpice Designs Decor"
    crumb="Portfolio"
  />

  <section class="container-luxe py-24 md:py-28" aria-labelledby="work-heading">
    <div class="mb-12 flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <span class="eyebrow mb-4">
          <span class="h-px w-8 bg-gold" aria-hidden="true" />
          {entries.length} featured events
        </span>
        <h2 id="work-heading" class="font-display text-3xl text-cream sm:text-4xl">
          Explore the collection
        </h2>
      </div>
      <p class="flex max-w-sm flex-wrap items-center gap-2 text-sm leading-relaxed text-muted">
        {[
          { key: 'Residential', label: 'Interiors' },
          { key: 'Commercial', label: 'Commercial' },
          { key: 'Events', label: 'Events' },
        ].map(({ key, label }) => (
          <span
            class:list={[
              'rounded-full border px-3 py-1 font-mono text-[0.68rem] uppercase tracking-[0.14em]',
              (counts[key] ?? 0) > 0
                ? 'border-gold/40 text-gold-600'
                : 'border-cream/10 text-muted-400',
            ]}
          >
            {label} · {counts[key] ?? 0}
          </span>
        ))}
      </p>
    </div>

    <PortfolioGallery client:load items={items} idPrefix="portfolio" />
  </section>

  <CTABanner
    title="Your event could be next."
    lead="Send us your date, venue, and guest list for a detailed, no-obligation quotation — everything under one roof."
  />
</BaseLayout>
