---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import PortfolioGallery from '@/components/PortfolioGallery.tsx';
import CTABanner from '@/components/CTABanner.astro';
import { toGalleryItems } from '@/utils/portfolio';
import heroImage from '@/assets/hero-3.jpg';

const entries = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);
const items = await toGalleryItems(entries);

---

<BaseLayout
  transparentHeader
  title="Portfolio"
  description="A selection of recent weddings, corporate events, and celebrations styled and delivered by Sulpice Designs Decor — dressed from tent to tablecloth."
>
  <PageHero
    eyebrow="Portfolio"
    title="Recent events, styled and delivered."
    lead="A selection of weddings, corporate functions, and celebrations across Zimbabwe and South Africa — dressed from tent to tablecloth."
    image={heroImage}
    alt="Event styling by Sulpice Designs Decor"
    crumb="Portfolio"
  />

  <section class="container-luxe section-pad" aria-labelledby="work-heading">
    <div class="mb-20 grid gap-10 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-8" data-reveal>
        <span class="mono-label flex items-center gap-4 text-gold-300">
          <span class="h-px w-10 bg-gold/70" aria-hidden="true"></span>
          {entries.length} occasions
        </span>
        <h2 id="work-heading" class="display-lg mt-8 text-balance text-cream">
          The <em class="text-gold-300">portfolio.</em>
        </h2>
      </div>
      <p class="max-w-sm text-[0.98rem] leading-[1.85] text-muted lg:col-span-4" data-reveal>
        Select any event to see what we supplied and styled — from marquee to place setting.
      </p>
    </div>

    <PortfolioGallery client:load items={items} idPrefix="portfolio" />
  </section>

  <CTABanner
    title="Your event could be next."
    lead="Send us your date, venue, and guest list for a detailed, no-obligation quotation — everything under one roof."
  />
</BaseLayout>
