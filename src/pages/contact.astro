---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import ContactForm from '@/components/ContactForm.tsx';
import Logo from '@/components/Logo.astro';
import { SITE, PROJECT_TYPES, BUDGET_RANGES } from '@/data/site';
import heroImage from '@/assets/about-studio.jpg';

const projectTypes = [...PROJECT_TYPES];
const budgets = [...BUDGET_RANGES];
---

<BaseLayout
  transparentHeader
  title="Contact & Get a Quotation"
  description="Get a quotation from Sulpice Designs Decor. Reach us by phone, email, or the enquiry form — we reply within one business day."
>
  <PageHero
    eyebrow="Contact"
    title="Let's plan your event."
    lead="Send us your event date, venue, and guest list and we'll prepare a detailed, no-obligation quotation — we reply to every enquiry within one business day."
    image={heroImage}
    alt="Elegant event styled by Sulpice Designs Decor"
    crumb="Contact"
  />

  <section class="container-luxe section-pad" aria-labelledby="contact-heading">
    <div class="grid gap-20 lg:grid-cols-12 lg:gap-12">
      <!-- Form -->
      <div class="lg:col-span-7" data-reveal>
        <span class="mono-label flex items-center gap-4 text-gold-300">
          <span class="h-px w-10 bg-gold/70" aria-hidden="true"></span>
          Request a quote
        </span>
        <h2 id="contact-heading" class="display-md mt-8 text-balance text-cream">
          Tell us about <em class="text-gold-300">your occasion.</em>
        </h2>
        <p class="mt-7 max-w-xl text-[0.98rem] leading-[1.85] text-muted">
          The more you share, the better we can prepare — your date, venue, guest count and
          the look you love. Photographs and references are always welcome.
        </p>

        <div id="enquiry" class="mt-16 scroll-mt-28">
          <ContactForm
            client:load
            projectTypes={projectTypes}
            budgets={budgets}
            whatsapp={SITE.whatsapp.replace(/\D/g, '')}
            email={SITE.email}
          />
        </div>
      </div>

      <!-- Details -->
      <aside
        class="space-y-14 lg:col-span-4 lg:col-start-9"
        aria-label="Contact details"
        data-reveal
        style="--reveal-delay:120ms"
      >
        <Logo width={130} />
        <div>
          <h3 class="mono-label text-[0.68rem] text-gold-300">Our hubs</h3>
          <ul class="mt-6 border-t border-cream/10">
            {
              SITE.branchContacts.map((branch, i) => (
                <li class="border-b border-cream/10 py-6">
                  <p class="font-display text-2xl text-cream">{SITE.hubs[i].name}</p>
                  <p class="mono-label mt-2 text-[0.66rem] text-gold-300">{SITE.hubs[i].role}</p>
                  <p class="mt-3 text-sm text-muted">{SITE.showrooms[i]}</p>
                  <p class="mt-4 flex flex-wrap gap-x-6 gap-y-2 text-[0.68rem] uppercase tracking-[0.24em]">
                    <a href={`tel:${branch.phoneHref}`} class="text-cream/80 transition-colors hover:text-gold-300">
                      {branch.phone}
                    </a>
                    <a
                      href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(SITE.hubs[i].mapQuery)}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-cream/60 transition-colors hover:text-gold-300"
                    >
                      Directions
                    </a>
                  </p>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <h3 class="mono-label text-[0.68rem] text-gold-300">Direct</h3>
          <dl class="mt-6 space-y-4 text-sm">
            <div class="flex justify-between gap-6 border-b border-cream/10 pb-4">
              <dt class="text-muted">Email</dt>
              <dd><a href={`mailto:${SITE.email}`} class="text-cream transition-colors hover:text-gold-300">{SITE.email}</a></dd>
            </div>
            <div class="flex justify-between gap-6 border-b border-cream/10 pb-4">
              <dt class="text-muted">Office</dt>
              <dd><a href={`tel:${SITE.landlineHref}`} class="text-cream transition-colors hover:text-gold-300">{SITE.landline}</a></dd>
            </div>
            <div class="flex justify-between gap-6 border-b border-cream/10 pb-4">
              <dt class="text-muted">WhatsApp</dt>
              <dd>
                <a href="https://wa.me/263772335903" target="_blank" rel="noopener noreferrer" class="text-cream transition-colors hover:text-gold-300">
                  {SITE.whatsapp}
                </a>
              </dd>
            </div>
          </dl>
        </div>

        <div>
          <h3 class="mono-label text-[0.68rem] text-gold-300">Hours</h3>
          <dl class="mt-6 space-y-4 text-sm">
            {
              SITE.hours.map((entry) => (
                <div class="flex justify-between gap-6 border-b border-cream/10 pb-4">
                  <dt class="text-muted">{entry.day}</dt>
                  <dd class="text-cream">{entry.time}</dd>
                </div>
              ))
            }
          </dl>
        </div>

        <figure>
          <Image
            src={heroImage}
            alt="Event styling on display at Sulpice Designs Decor"
            widths={[400, 640, 900]}
            sizes="(min-width: 1024px) 30vw, 90vw"
            loading="lazy"
            class="aspect-[4/3] w-full object-cover"
          />
          <figcaption class="mono-label mt-4 text-[0.66rem] text-muted-400">
            Visits to our showrooms by appointment
          </figcaption>
        </figure>

        <ul class="flex flex-wrap gap-x-6 gap-y-3">
          {
            SITE.socials.map((social) => (
              <li>
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-[0.68rem] uppercase tracking-[0.3em] text-cream/60 transition-colors hover:text-gold-300"
                >
                  {social.name}
                </a>
              </li>
            ))
          }
        </ul>
      </aside>
    </div>
  </section>
</BaseLayout>
