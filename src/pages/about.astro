---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Button from '@/components/Button.astro';
import CTABanner from '@/components/CTABanner.astro';

import aboutStudio from '@/assets/about-studio.jpg';
import aboutFounder from '@/assets/about-founder.jpg';
import aboutDetail from '@/assets/about-detail.jpg';
import missionImage from '@/assets/project-3.jpg';
import Logo from '@/components/Logo.astro';
import sewaImage from '@/assets/profile/sewa-class.jpg';
import ceilingImage from '@/assets/profile/ceiling-installation.jpg';
import { TEAM } from '@/data/site';

const principles = [
  {
    title: 'Passionate about events',
    body: 'We love what we do and we will go all out to ensure every event is a success.',
  },
  {
    title: 'Everything under one roof',
    body: 'All types of equipment, in one place — a wide choice to choose from, and one point of contact.',
  },
  {
    title: 'Smooth delivery',
    body: 'With our own trucks, delivery is smooth — on time, right the first time, every time.',
  },
  {
    title: 'Experienced staff',
    body: 'A highly experienced team guarantees exceptional service, from your first enquiry to breakdown.',
  },
];

const values = [
  { value: '2008', label: 'Company established' },
  { value: '18+', label: 'Years styling events' },
  { value: '3', label: 'Showrooms — ZW & ZA' },
  { value: '100%', label: 'Delivered by our own fleet' },
];
---

<BaseLayout
  transparentHeader
  title="About Us"
  description="Sulpice Designs Decor is a premium events décor and hiring services company, established in 2008 with showrooms in Harare, Bulawayo, and Fourways — styling weddings, corporate events, and every celebration in between."
>
  <PageHero
    eyebrow="About us"
    title="The people behind your perfect day."
    lead="From our headquarters in Harare, our branch in Bulawayo and our creative studio in Fourways, Johannesburg, we dress weddings, corporate occasions and celebrations of every kind — with care, detail and a genuine love for what we do."
    image={aboutStudio}
    alt="Events décor and hiring by Sulpice Designs Decor"
    crumb="About"
  />

  <!-- Why choose us -->
  <section class="container-luxe section-pad" aria-labelledby="philosophy-heading">
    <SectionHeading
      id="philosophy-heading"
      eyebrow="Why choose us"
      title="Four promises, on every hire."
      lead="We are passionate about events. Here is what you can count on from the moment you call."
      class="mb-20"
    />

    <div class="grid border-t border-cream/15 sm:grid-cols-2 lg:grid-cols-4">
      {
        principles.map((p, i) => (
          <article
            class="border-b border-cream/15 py-10 sm:pr-8 lg:border-b-0 lg:border-l lg:px-8 lg:first:border-l-0 lg:first:pl-0"
            data-reveal
            style={`--reveal-delay:${i * 100}ms`}
          >
            <span class="index-num text-lg text-gold-300">{['i', 'ii', 'iii', 'iv'][i]}.</span>
            <h3 class="mt-8 font-display text-[1.9rem] leading-tight text-cream">{p.title}</h3>
            <p class="mt-4 text-sm leading-[1.8] text-muted">{p.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Our story -->
  <section class="surface-ivory section-pad" aria-labelledby="founder-heading">
    <div class="container-luxe grid items-center gap-20 lg:grid-cols-12 lg:gap-12">
      <div class="relative lg:col-span-6">
        <div class="overflow-hidden" data-reveal-clip>
          <Image
            src={aboutFounder}
            alt="The Sulpice Designs team styling an event"
            widths={[600, 900, 1200]}
            sizes="(min-width: 1024px) 45vw, 92vw"
            loading="lazy"
            class="aspect-[4/5] w-full object-cover"
          />
        </div>
        <div
          class="absolute -bottom-12 -right-4 hidden w-[38%] border-[10px] border-ivory sm:block lg:-right-16"
          data-reveal
          style="--reveal-delay:250ms"
        >
          <Image
            src={aboutDetail}
            alt="Elegantly dressed event table"
            widths={[300, 500]}
            sizes="16rem"
            loading="lazy"
            class="aspect-[3/4] w-full object-cover"
          />
        </div>
      </div>

      <div class="lg:col-span-5 lg:col-start-8" data-reveal style="--reveal-delay:120ms">
        <span class="mono-label flex items-center gap-4 text-gold-300">
          <span class="h-px w-10 bg-gold/70" aria-hidden="true"></span>
          Our story
        </span>
        <h2 id="founder-heading" class="display-md mt-8 text-balance text-cream">
          Every event, from first enquiry <em class="text-gold-300">to the final dance.</em>
        </h2>
        <div class="mt-8 space-y-5 text-[1.02rem] leading-[1.9] text-muted">
          <p>
            Established in <span class="text-cream">2008</span>, Sulpice Designs Decor is a
            premium events décor and hiring company offering a complete, high-end solution
            for every kind of occasion — with weddings at the very top of our list. Corporate
            events, birthdays, and any gathering, formal or casual: we have the pieces to suit
            them all.
          </p>
          <p>
            From considered tables and plush seating to fine crockery, luxurious linen, tents
            and pergolas, fresh flowers and finishing accessories — it is the range, and the
            small details, that make all the difference. We design, deliver and style, then
            quietly pack it all away, so your only task is to enjoy the day.
          </p>
        </div>
        <p class="mt-10 font-display text-2xl italic text-gold-300">
          Harare · Bulawayo · Fourways
        </p>
        <div class="mt-10">
          <Button href="/contact" variant="outline">Plan your event</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Vision & mission -->
  <section class="container-luxe section-pad" aria-labelledby="mission-heading">
    <div class="grid items-start gap-20 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-6" data-reveal>
        <span class="mono-label flex items-center gap-4 text-gold-300">
          <span class="h-px w-10 bg-gold/70" aria-hidden="true"></span>
          Vision &amp; mission
        </span>
        <h2 id="mission-heading" class="display-md mt-8 text-balance text-cream">
          To be the most trusted name in <em class="text-gold-300">event décor &amp; hire.</em>
        </h2>
        <p class="mt-8 max-w-xl text-[1.02rem] leading-[1.9] text-muted">
          We value your time and clear communication, and we work to make sure you live your
          dream day with a smile — calm, unhurried and free of stress. That is what we are
          here for. Your dream is our passion, and your passion is our mission.
        </p>

        <dl class="mt-14 grid grid-cols-2 gap-x-8 gap-y-10 border-t border-cream/15 pt-10 sm:grid-cols-4">
          {
            values.map((v, i) => (
              <div data-reveal style={`--reveal-delay:${i * 80}ms`}>
                <dt class="sr-only">{v.label}</dt>
                <dd>
                  <span class="block font-display text-5xl font-light leading-none text-cream">{v.value}</span>
                  <span class="mono-label mt-3 block text-[0.66rem] text-muted-400">{v.label}</span>
                </dd>
              </div>
            ))
          }
        </dl>

        <div class="mt-14" data-reveal>
          <p class="mono-label text-[0.68rem] text-gold-300">The occasions we dress</p>
          <ul class="mt-6 border-t border-cream/10">
            {
              [
                'Weddings — ceremonies & receptions',
                'Birthdays — large or intimate',
                'Corporate — year-end functions, launches & award ceremonies',
                'Formal or casual — tailored to any event, large or small',
              ].map((item) => (
                <li class="flex items-center gap-4 border-b border-cream/10 py-4 text-[0.95rem] text-cream/85">
                  <span class="diamond" aria-hidden="true" />
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div class="lg:col-span-5 lg:col-start-8 lg:mt-24">
        <div class="overflow-hidden" data-reveal-clip>
          <Image
            src={missionImage}
            alt="Event styling by Sulpice Designs Decor"
            widths={[600, 900, 1200]}
            sizes="(min-width: 1024px) 40vw, 92vw"
            loading="lazy"
            class="aspect-[3/4] w-full object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- SEWA -->
  <section id="sewa" class="surface-ivory section-pad scroll-mt-20" aria-labelledby="sewa-heading">
    <div class="container-luxe grid items-center gap-16 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-5" data-reveal>
        <span class="mono-label flex items-center gap-4 text-gold-300">
          <span class="h-px w-10 bg-gold/70" aria-hidden="true"></span>
          SEWA — Sulpice Events &amp; Weddings Academy
        </span>
        <h2 id="sewa-heading" class="display-md mt-8 text-balance text-cream">
          Training the next generation <em class="text-gold-300">of event makers.</em>
        </h2>
        <p class="mt-8 text-[1.02rem] leading-[1.9] text-muted">
          SEWA is our professional training division. Run from our Harare training hub, its
          masterclasses and intakes pass on eighteen years of craft to aspiring planners,
          stylists and décor entrepreneurs across Southern Africa.
        </p>
        <ul class="mt-10 border-t border-cream/15">
          {
            [
              'Event & wedding styling masterclasses',
              'Floral architecture & design intakes',
              'Spatial planning',
              'Artificial intelligence for décor design',
              'Décor business strategy & management',
            ].map((item) => (
              <li class="flex items-center gap-4 border-b border-cream/15 py-3.5 text-[0.95rem] text-cream/85">
                <span class="diamond" aria-hidden="true" />
                {item}
              </li>
            ))
          }
        </ul>
        <div class="mt-10">
          <Button href="/contact" variant="outline">Enquire about the next intake</Button>
        </div>
      </div>
      <div class="grid grid-cols-2 gap-3 lg:col-span-6 lg:col-start-7">
        <div class="col-span-2 overflow-hidden" data-reveal-clip>
          <Image
            src={sewaImage}
            alt="A SEWA masterclass intake with their instructors"
            widths={[400, 512]}
            sizes="(min-width: 1024px) 45vw, 92vw"
            loading="lazy"
            class="aspect-[16/10] w-full object-cover"
          />
        </div>
        <p class="mono-label col-span-2 mt-2 text-[0.66rem] text-muted-400">
          A SEWA intake at the Harare training hub
        </p>
      </div>
    </div>
  </section>

  <!-- Team -->
  <section class="container-luxe section-pad" aria-labelledby="team-heading">
    <div class="grid gap-16 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-4">
        <SectionHeading
          id="team-heading"
          eyebrow="Leadership"
          title="The people who carry the detail."
          lead="A family-led team that pairs creative direction with engineering, floristry and operational discipline."
        />
        <div class="mt-14 hidden overflow-hidden lg:block" data-reveal-clip>
          <Image
            src={ceilingImage}
            alt="Floral ceiling installation and monogrammed dance floor by Sulpice Designs"
            widths={[400, 512]}
            sizes="30vw"
            loading="lazy"
            class="aspect-[4/3] w-full object-cover"
          />
        </div>
      </div>
      <ul class="border-t border-cream/15 lg:col-span-7 lg:col-start-6">
        {
          TEAM.map((member, i) => (
            <li
              class="grid gap-3 border-b border-cream/15 py-8 sm:grid-cols-[1fr_1.2fr] sm:gap-10"
              data-reveal
              style={`--reveal-delay:${i * 70}ms`}
            >
              <div>
                <p class="font-display text-[1.75rem] leading-tight text-cream">{member.name}</p>
                <p class="mono-label mt-3 text-[0.66rem] text-gold-300">{member.role}</p>
              </div>
              <p class="text-sm leading-[1.85] text-muted sm:pt-2">{member.note}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Brand band -->
  <section class="bg-teal-900 py-28 md:py-36" aria-label="Sulpice Designs Decor">
    <div class="container-luxe flex flex-col items-center text-center" data-reveal>
      <Logo width={280} />
      <p class="mono-label mt-10 text-[0.68rem] text-gold-300">
        Events décor &amp; hiring · Est. 2008
      </p>
    </div>
  </section>

  <CTABanner
    title="Planning an event?"
    lead="Visit our showroom in Harare, Bulawayo, or Fourways — or send us your date and guest list for a no-obligation quotation."
  />
</BaseLayout>
