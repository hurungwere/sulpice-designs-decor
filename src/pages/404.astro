---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
---

<BaseLayout
  title="Page not found"
  description="The page you were looking for could not be found."
  noindex
>
  <section class="container-luxe relative flex min-h-[86svh] flex-col items-center justify-center overflow-hidden pb-24 pt-40 text-center">
    <span class="mono-label flex items-center gap-4 text-gold-300">
      <span class="h-px w-10 bg-gold/70" aria-hidden="true"></span>
      Error 404
      <span class="h-px w-10 bg-gold/70" aria-hidden="true"></span>
    </span>
    <h1 class="display-xl mt-10 text-cream">Lost in the <em class="text-gold-300">details.</em></h1>
    <p class="mt-8 max-w-md text-[0.98rem] leading-[1.85] text-muted">
      The page you were looking for has moved, or never existed. Let us return you to
      something beautiful.
    </p>
    <div class="mt-12 flex flex-col items-center gap-7 sm:flex-row sm:gap-10">
      <Button href="/" size="lg">Return home</Button>
      <a href="/portfolio" class="link-hairline text-cream hover:text-gold-300">View the portfolio</a>
    </div>
  </section>
</BaseLayout>
