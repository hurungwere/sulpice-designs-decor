---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import { Icon } from 'astro-icon/components';
---

<BaseLayout
  title="Page not found"
  description="The page you were looking for could not be found."
  noindex
>
  <section class="container-luxe relative flex min-h-[72svh] flex-col items-center justify-center overflow-hidden py-32 text-center">
    <span
      class="pointer-events-none absolute select-none font-display text-[11rem] leading-none text-charcoal/[0.05] sm:text-[16rem]"
      aria-hidden="true"
    >
      404
    </span>
    <span class="eyebrow relative justify-center">
      <span class="h-px w-8 bg-gold" aria-hidden="true" />
      Error 404
    </span>
    <h1 class="relative mt-5 font-display text-5xl text-charcoal sm:text-7xl">Lost in the details</h1>
    <p class="relative mt-5 max-w-md text-base leading-relaxed text-muted">
      The page you're looking for has moved or never existed. Let's get you back
      to something beautiful.
    </p>
    <div class="relative mt-9 flex flex-wrap items-center justify-center gap-3">
      <Button href="/" size="lg">
        Back home
        <Icon name="lucide:arrow-right" class="h-4 w-4" />
      </Button>
      <Button href="/portfolio" variant="outline" size="lg">View portfolio</Button>
      <Button href="/services" variant="outline" size="lg">See what we hire</Button>
    </div>
  </section>
</BaseLayout>
