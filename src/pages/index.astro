---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import StatsBand from '@/components/StatsBand.astro';
import IntroSection from '@/components/IntroSection.astro';
import HireCatalogue from '@/components/HireCatalogue.astro';
import BespokeBand from '@/components/BespokeBand.astro';
import BeyondHire from '@/components/BeyondHire.astro';
import Manifesto from '@/components/Manifesto.astro';
import ClientsStrip from '@/components/ClientsStrip.astro';
import HubsSection from '@/components/HubsSection.astro';
import WorkSection from '@/components/WorkSection.astro';
import Testimonials from '@/components/Testimonials.astro';
import GallerySocial from '@/components/GallerySocial.astro';
import CTABanner from '@/components/CTABanner.astro';
---

<BaseLayout
  title="Events Décor & Hiring Services"
  description="Sulpice Designs Decor is a premium events décor and hiring company across Zimbabwe and South Africa — weddings, corporate events, and celebrations of every kind, delivered and styled by our own crew."
  transparentHeader
>
  <Hero />
  <StatsBand />
  <IntroSection />
  <HireCatalogue />
  <BespokeBand />
  <BeyondHire />
  <Manifesto />
  <WorkSection />
  <ClientsStrip />
  <HubsSection />
  <Testimonials />
  <GallerySocial />
  <CTABanner />
</BaseLayout>
